capability Theme

// "light", "dark" or "system" (follow the device). public/theme-boot.js
// applies the saved choice before the first paint; this keeps it in sync.

state
  choice: "system"
  mode: "dark"

action
  apply() {
    let dark = this.choice is "dark"
    if this.choice is "system" {
      dark = window.matchMedia("(prefers-color-scheme: dark)").matches
    }
    this.mode = dark ? "dark" : "light"
    document.documentElement.classList.toggle("dark", dark)
    try {
      // Tylix's injected head script reads "theme" on the next page load.
      localStorage.setItem("theme", this.mode)
    } catch (err) {
      // private mode
    }
  }

  set(choice) {
    this.choice = choice
    try {
      localStorage.setItem("aos-theme", choice)
    } catch (err) {
      // private mode: the choice lasts for this page only
    }
    this.apply()
  }

  toggle() {
    this.set(this.mode is "dark" ? "light" : "dark")
  }

init
  async {
    let saved = "system"
    try {
      saved = localStorage.getItem("aos-theme") ?? "system"
    } catch (err) {
      saved = "system"
    }
    this.choice = saved
    this.apply()
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      if this.choice is "system" {
        this.apply()
      }
    })
  }
