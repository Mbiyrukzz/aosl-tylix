action
  // Products plus the non-product areas, for ticket forms.
  topics() {
    return [...this.products.map(p => ({ value: p.slug, label: p.name })), ...this.areas]
  }

  find(slug) {
    return this.products.find(p => p.slug is slug) ?? null
  }

  nameOf(slug) {
    const p = this.products.find(x => x.slug is slug)
    if p {
      return p.name
    }
    const a = this.areas.find(x => x.value is slug)
    return a ? a.label : "General"
  }
