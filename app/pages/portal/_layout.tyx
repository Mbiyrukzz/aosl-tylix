component PortalLayout

// The client portal: sidebar, top bar, the support launcher and toasts.
// Guests are sent to sign in; staff are sent to the console.

uses
  Auth
  Live

onMount
  async {
    const me = Auth.user ?? (await Auth.refresh())
    if not me {
      window.location.href = "/login?next=" + encodeURIComponent(window.location.pathname + window.location.search)
      return null
    }
    if (me.role is "staff" or me.role is "admin") and not window.location.search.includes("preview") {
      window.location.href = "/admin"
      return null
    }
    Live.start(false)
  }

template
  <div class="app">
    <AppSidebar area="portal" />
    <div class="app-column">
      <AppTopbar area="portal" />
      <main id="main" class="app-main"><div class="app-page" data-tylix-slot="true"></div></main>
    </div>
    <SupportLauncher />
    <CommandPalette area="portal" />
    <Toast />
  </div>
