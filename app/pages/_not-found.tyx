page NotFound

import { IconArrowLeft, IconHome } from "tylix-icons"

title "Page not found · Ashmif"

template
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid mask-fade-b"></div>
    <div class="relative tx-container py-28 text-center">
      <span class="aos-mark h-14 text-brand"></span>
      <p class="mt-8 font-mono text-sm text-brand">404</p>
      <h1 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">This page took a wrong turn</h1>
      <p class="mt-4 text-soft max-w-md mx-auto">The link may be old, or the page has moved. Let's get you back on track.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="tx-btn tx-btn-primary"><IconHome /> Home</a>
        <button type="button" class="tx-btn tx-btn-outline" onclick="{{ window.history.back() }}"><IconArrowLeft /> Go back</button>
      </div>
    </div>
  </section>
