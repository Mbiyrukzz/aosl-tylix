page ForgotPassword

import { IconArrowLeft, IconMailOpen } from "tylix-icons"

title "Reset your password · Ashmif"

uses
  Live

state
  email: ""
  sent: false
  error: ""
  submitting: false

action
  async submit() {
    this.error = ""
    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      this.error = "Enter a valid email address."
      return null
    }
    this.submitting = true
    const r = await useApi("/api/auth/forgot-password", { method: "POST", body: { email: this.email } })
    this.submitting = false
    if r.ok {
      this.sent = true
    } else {
      this.error = Live.errorOf(r, "Couldn't send the link. Try again.")
    }
  }

template
  <AuthFrame heading="Locked out? It happens." subheading="We'll email you a secure link to choose a new password.">
    <div class="lg:hidden mb-8"><BrandLogo /></div>
{{#if sent}}
    <div class="text-center py-6">
      <span class="mx-auto w-14 h-14 rounded-2xl bg-brand-soft/15 text-brand flex items-center justify-center"><IconMailOpen class="w-7 h-7" /></span>
      <h1 class="mt-5 text-2xl font-bold tracking-tight">Check your email</h1>
      <p class="text-sm text-muted mt-2">If {{ email }} has an account, a reset link is on its way. It works for one hour.</p>
      <a href="/login" class="tx-btn tx-btn-outline mt-7"><IconArrowLeft /> Back to sign in</a>
    </div>
{{#else}}
    <h1 class="text-2xl font-bold tracking-tight">Reset your password</h1>
    <p class="text-sm text-muted mt-1 mb-7">Enter the email you sign in with.</p>
{{#if error}}
    <div class="tx-alert tx-alert-error mb-5" role="alert"><p>{{ error }}</p></div>
{{/if}}
    <form onsubmit.prevent="{{ submit() }}" novalidate>
      <div class="tx-field">
        <label for="email" class="tx-label">Email</label>
        <input id="email" type="email" autocomplete="email" autofocus class="tx-input" bind:value="{{ email }}" />
      </div>
      <button type="submit" class="tx-btn tx-btn-primary tx-btn-block" disabled="{{ submitting }}">{{ submitting ? "Sending…" : "Send reset link" }}</button>
    </form>
    <p class="text-sm text-center mt-7"><a href="/login" class="tx-link">Back to sign in</a></p>
{{/if}}
  </AuthFrame>
