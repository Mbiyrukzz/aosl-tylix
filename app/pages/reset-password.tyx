page ResetPassword

import { IconArrowRight } from "tylix-icons"

title "Choose a password · Ashmif"

uses
  Live

state
  token: ""
  email: ""
  password: ""
  confirm: ""
  welcome: false
  linkComplete: false
  error: ""
  submitting: false

action
  async submit() {
    this.error = ""
    if this.password.length < 8 {
      this.error = "Use at least 8 characters."
      return null
    }
    if this.password is not this.confirm {
      this.error = "The two passwords don't match."
      return null
    }
    this.submitting = true
    const r = await useApi("/api/auth/reset-password", { method: "POST", body: { email: this.email, token: this.token, password: this.password } })
    this.submitting = false
    if r.ok {
      window.location.href = "/login?reset=1"
    } else {
      this.error = Live.errorOf(r, "This link is invalid or has expired. Ask for a new one.")
    }
  }

onMount
  {
    const params = new URLSearchParams(window.location.search)
    this.token = params.get("token") ?? ""
    this.email = params.get("email") ?? ""
    this.welcome = params.get("welcome") is "1"
    this.linkComplete = this.token.length > 0 and this.email.length > 0
  }

template
  <AuthFrame heading="{{ welcome ? 'Welcome to the Ashmif portal' : 'Choose a new password' }}" subheading="Pick something you don't use anywhere else. You'll be signed out on other devices.">
    <div class="lg:hidden mb-8"><BrandLogo /></div>
{{#if not linkComplete}}
    <h1 class="text-2xl font-bold tracking-tight">This link is incomplete</h1>
    <p class="text-sm text-muted mt-2 mb-6">Open the link from the email again, or ask for a new one.</p>
    <a href="/forgot-password" class="tx-btn tx-btn-primary">Get a new link</a>
{{#else}}
    <h1 class="text-2xl font-bold tracking-tight">{{ welcome ? "Set your password" : "New password" }}</h1>
    <p class="text-sm text-muted mt-1 mb-7">For {{ email }}</p>
{{#if error}}
    <div class="tx-alert tx-alert-error mb-5" role="alert"><p>{{ error }}</p></div>
{{/if}}
    <form onsubmit.prevent="{{ submit() }}" novalidate>
      <div class="tx-field">
        <label for="password" class="tx-label">Password</label>
        <input id="password" type="password" autocomplete="new-password" class="tx-input" bind:value="{{ password }}" />
      </div>
      <div class="tx-field">
        <label for="confirm" class="tx-label">Confirm password</label>
        <input id="confirm" type="password" autocomplete="new-password" class="tx-input" bind:value="{{ confirm }}" />
      </div>
      <button type="submit" class="tx-btn tx-btn-primary tx-btn-block" disabled="{{ submitting }}">{{ submitting ? "Saving…" : "Save password" }} <IconArrowRight /></button>
    </form>
{{/if}}
  </AuthFrame>
