page Login

import { IconArrowRight, IconEye, IconEyeSlash, IconMail } from "tylix-icons"

title "Sign in · Ashmif"

needs
  Auth

uses
  Live

state
  email: ""
  password: ""
  remember: true
  show: false
  error: ""
  notice: ""
  unverified: false
  submitting: false
  resent: false

action
  nextUrl() {
    const next = new URLSearchParams(window.location.search).get("next") ?? ""
    return next.startsWith("/") and not next.startsWith("//") ? next : Auth.home()
  }

  async submit() {
    if this.submitting {
      return null
    }
    this.error = ""
    this.unverified = false
    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      this.error = "Enter a valid email address."
      return null
    }
    if not this.password {
      this.error = "Enter your password."
      return null
    }
    this.submitting = true
    const r = await Auth.login(this.email, this.password, this.remember)
    if r.ok {
      window.location.href = this.nextUrl()
      return null
    }
    this.submitting = false
    if r.data?.code is "EMAIL_NOT_VERIFIED" {
      this.unverified = true
      this.error = "Please verify your email first. Check your inbox for the link."
    } else if r.status is 401 {
      this.error = "That email and password don't match."
    } else {
      this.error = Live.errorOf(r, "Couldn't sign in. Try again.")
    }
  }

  async resend() {
    await useApi("/api/auth/resend-verification", { method: "POST", body: { email: this.email } })
    this.resent = true
  }

onMount
  {
    if Auth.user {
      window.location.href = this.nextUrl()
      return null
    }
    const params = new URLSearchParams(window.location.search)
    if params.get("registered") {
      this.notice = "Account created. Check your email for the verification link, then sign in."
    }
    if params.get("reset") {
      this.notice = "Password updated. Sign in with your new password."
    }
  }

template
  <AuthFrame heading="Welcome back to your portal" subheading="Everything about your account with Ashmif Office Solutions, in one place.">
    <div class="lg:hidden mb-8"><BrandLogo /></div>
    <h1 class="text-2xl font-bold tracking-tight">Sign in</h1>
    <p class="text-sm text-muted mt-1 mb-7">Clients and Ashmif staff sign in here.</p>

{{#if notice}}
    <div class="tx-alert tx-alert-success mb-5" role="status"><p>{{ notice }}</p></div>
{{/if}}
{{#if error}}
    <div class="tx-alert tx-alert-error mb-5" role="alert">
      <div>
        <p>{{ error }}</p>
{{#if unverified}}
{{#if resent}}
        <p class="mt-1 text-xs">A new link is on its way.</p>
{{#else}}
        <button type="button" class="mt-1.5 text-xs font-semibold underline bg-transparent border-0 p-0 cursor-pointer text-inherit" onclick="{{ resend() }}">Send the link again</button>
{{/if}}
{{/if}}
      </div>
    </div>
{{/if}}

    <OAuthButtons returnTo="{{ '/portal' }}" />

    <form onsubmit.prevent="{{ submit() }}" novalidate>
      <div class="tx-field">
        <label for="email" class="tx-label">Email</label>
        <input id="email" type="email" autocomplete="email" autofocus class="tx-input" placeholder="you@company.co.ke" bind:value="{{ email }}" />
      </div>
      <div class="tx-field">
        <div class="flex items-center justify-between mb-1.5">
          <label for="password" class="tx-label !mb-0">Password</label>
          <a href="/forgot-password" class="text-xs tx-link">Forgot password?</a>
        </div>
        <div class="relative">
          <input id="password" type="{{ show ? 'text' : 'password' }}" autocomplete="current-password" class="tx-input pr-11" placeholder="••••••••" bind:value="{{ password }}" />
          <button type="button" class="absolute right-1.5 top-1/2 -translate-y-1/2 tx-icon-btn !w-8 !h-8" aria-label="{{ show ? 'Hide password' : 'Show password' }}" onclick="{{ show = not show }}">
{{#if show}}<IconEyeSlash />{{#else}}<IconEye />{{/if}}
          </button>
        </div>
      </div>
      <label class="flex items-center gap-2 text-sm text-soft mb-6"><input type="checkbox" class="tx-check" bind:checked="{{ remember }}" /> Keep me signed in</label>
      <button type="submit" class="tx-btn tx-btn-primary tx-btn-block tx-btn-lg" disabled="{{ submitting }}">
{{#if submitting}}<span class="tx-spinner"></span> Signing in…{{#else}}Sign in <IconArrowRight />{{/if}}
      </button>
    </form>

    <p class="text-sm text-muted text-center mt-7">New to Ashmif? <a href="/register" class="tx-link">Create a client account</a></p>
  </AuthFrame>
