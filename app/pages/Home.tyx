      <a href="/products/payroflix" class="reveal reveal-d1 tx-panel tx-hover p-6 no-underline text-ink flex flex-col">
        <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-semibold text-[#8b5cf6]">HR & payroll</p><h3 class="mt-1 text-xl font-bold">Payroflix</h3><p class="mt-1.5 text-sm text-soft">Payroll with statutory deductions done for you.</p></div><span class="product-icon shrink-0 bg-[#8b5cf6]/10 text-[#8b5cf6]"><ProductIcon slug="payroflix" cls="w-6 h-6" /></span></div>
        <div class="mt-6 shot p-4 text-[11px] space-y-1.5">
          <div class="flex justify-between"><span class="text-muted">Gross pay</span><span class="tabular font-medium">85,000.00</span></div>
          <div class="flex justify-between"><span class="text-muted">PAYE</span><span class="tabular">−14,632.40</span></div>
          <div class="flex justify-between"><span class="text-muted">NSSF · SHIF · Housing</span><span class="tabular">−6,920.00</span></div>
          <div class="flex justify-between pt-2 mt-1 border-t border-line text-sm font-bold"><span>Net pay</span><span class="tabular text-brand">63,447.60</span></div>
        </div>
      </a>

      <a href="/products/smartrealtors" class="reveal reveal-d2 tx-panel tx-hover p-6 no-underline text-ink flex flex-col">
        <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-semibold text-[#f97316]">Property</p><h3 class="mt-1 text-xl font-bold">SmartRealtors</h3><p class="mt-1.5 text-sm text-soft">Rent collected, reminders sent, evenings back.</p></div><span class="product-icon shrink-0 bg-[#f97316]/10 text-[#f97316]"><ProductIcon slug="smartrealtors" cls="w-6 h-6" /></span></div>
        <div class="mt-6 shot p-4">
          <p class="text-[11px] text-muted">Rent collected · last 6 months</p>
          <div class="mt-3 flex items-end gap-1.5 h-16">
            <span class="flex-1 rounded-t bg-[#f97316]/30" style="height:55%"></span><span class="flex-1 rounded-t bg-[#f97316]/30" style="height:70%"></span><span class="flex-1 rounded-t bg-[#f97316]/30" style="height:62%"></span><span class="flex-1 rounded-t bg-[#f97316]/30" style="height:80%"></span><span class="flex-1 rounded-t bg-[#f97316]/30" style="height:74%"></span><span class="flex-1 rounded-t bg-[#f97316]" style="height:94%"></span>
          </div>
        </div>
      </a>

      <a href="/products/smartfreight" class="reveal tx-panel tx-hover p-6 no-underline text-ink flex flex-col">
        <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-semibold text-[#6366f1]">Logistics</p><h3 class="mt-1 text-xl font-bold">SmartFreight</h3><p class="mt-1.5 text-sm text-soft">Manifests to delivery orders, one system.</p></div><span class="product-icon shrink-0 bg-[#6366f1]/10 text-[#6366f1]"><ProductIcon slug="smartfreight" cls="w-6 h-6" /></span></div>
        <div class="mt-6 shot p-4">
          <p class="text-[11px] font-mono text-muted">BL-MSA-20931 · 40ft</p>
          <div class="mt-4 flex items-start text-[10px] font-medium">
