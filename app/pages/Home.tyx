page Home

import { IconInbox, IconPencil, IconStar, IconArchive, IconGlobe, IconDeviceMobile, IconArrowRight, IconArrowUpRight, IconCheck, IconCheckCircle, IconClock, IconMessageCircle, IconTicket, IconReceipt, IconKanban, IconMobileMoney, IconSend, IconShieldCheck, IconMapPin, IconUsers, IconHeadphones, IconServer, IconGitBranch, IconMessagesSquare, IconCode, IconLayoutDashboard, IconPackage, IconBell, IconSearch } from "tylix-icons"

title "Ashmif Office Solutions · Client portal and team workspace"

uses
  Auth
  Catalog

state
  sent: 18240
  delivered: 17912
  toastIdx: 0
  toasts: [
    { title: "Payment received", body: "KES 14,999 · INV-2026-0041", icon: "pay" },
    { title: "Ticket resolved", body: "AOS-1042 · rated 5★", icon: "ok" },
    { title: "Renewal reminder sent", body: "coastline.co.ke · 14 days", icon: "bell" }
  ]
  tour: "support"
  cpu: 34
  eng: "next"
  clock: ""
  health: ""
  healthOk: true
  rail: [
    { id: "nextjs", name: "Next.js" }, { id: "java", name: "Java" }, { id: "tylix", name: "Tylix" }, { id: "vue", name: "Vue" },
    { id: "nuxt", name: "Nuxt" }, { id: "angular", name: "Angular" }, { id: "nodejs", name: "Node.js" }, { id: "php", name: "PHP" },
    { id: "django", name: "Django" }, { id: "fastapi", name: "FastAPI" }, { id: "dotnet", name: ".NET" }, { id: "go", name: "Go" },
    { id: "docker", name: "Docker" }, { id: "aws", name: "AWS" }, { id: "cloudflare", name: "Cloudflare" }, { id: "digitalocean", name: "DigitalOcean" },
    { id: "flux", name: "Tylix Flux" }
  ]
  steps: [
    { n: "01", title: "Listen", body: "We sit with the people who do the work and write down goals, users and budget, plainly.", log: "✔ brief signed off" },
    { n: "02", title: "Design", body: "Clickable screens and a fixed scope before code starts. No surprises later.", log: "✔ screens approved" },
    { n: "03", title: "Build", body: "Weekly demos you can click through. Follow every milestone live in your portal.", log: "● demo every Thursday" },
    { n: "04", title: "Run", body: "We deploy with Flux, watch it and support it with response times you can see.", log: "○ live, watched, supported" }
  ]

computed
  toast() {
    return this.toasts[this.toastIdx]
  }

  rate() {
    return Math.round((this.delivered / this.sent) * 1000) / 10
  }

onMount
  {
    const tick = () => {
      this.clock = new Date().toLocaleTimeString("en-GB", { timeZone: "Africa/Nairobi", hour: "2-digit", minute: "2-digit" })
    }
    tick()
    setInterval(tick, 15000)
    useApi("/api/public/status").then(r => {
      if r.ok {
        const bad = r.data.products.filter(p => p.state is not "operational").length
        this.healthOk = bad is 0
        this.health = bad ? (bad is 1 ? "1 service needs attention" : `${bad} services need attention`) : "all systems operational"
      }
    })
    setInterval(() => {
      if document.hidden {
        return null
      }
      const n = 3 + Math.floor(Math.random() * 9)
      this.sent += n
      this.delivered += n - (Math.random() < 0.3 ? 1 : 0)
      this.cpu = 22 + Math.floor(Math.random() * 30)
    }, 1400)
    setInterval(() => {
      this.toastIdx = (this.toastIdx + 1) % this.toasts.length
    }, 3600)
  }

template
<div>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid mask-fade-b"></div>
    <div class="relative tx-container pt-14 sm:pt-24 text-center">
      <a href="/status" class="fade-up inline-flex items-center gap-2.5 rounded-full border border-line bg-panel/80 backdrop-blur px-3.5 py-1.5 font-mono text-[11px] sm:text-xs text-soft no-underline hover:border-line-strong transition-colors mb-8">
        <span class="text-brand">❯</span>
        <span>mombasa <span class="text-ink tabular">{{ clock or "--:--" }}</span> EAT</span>
        <span class="text-muted">·</span>
        <span class="inline-flex items-center gap-1.5"><span class="{{ 'tx-live ' + (healthOk ? 'text-mint' : 'text-peach') }}"></span><span class="hidden sm:inline">{{ health or "checking systems…" }}</span><span class="sm:hidden">{{ healthOk ? "all good" : "see status" }}</span></span>
      </a>
      <h1 class="fade-up fade-up-2 text-[2.6rem] leading-[1.02] sm:text-[4.25rem] lg:text-[5.25rem] font-bold tracking-[-0.045em] text-balance max-w-5xl mx-auto">
        Everything between you and <span class="text-brand">Ashmif</span>, in one place
      </h1>
      <p class="fade-up fade-up-3 mt-6 text-base sm:text-xl text-soft max-w-2xl mx-auto leading-relaxed text-pretty">
        Ashmif Office Solutions is a software and engineering company in Mombasa. This is where our clients and our team work together every day: support tickets, messages, projects, services, invoices and payments, from the first brief to a live system and every renewal after.
      </p>
      <div class="fade-up fade-up-4 mt-9 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 max-w-sm sm:max-w-none mx-auto">
{{#if Auth.user}}
        <a href="{{ Auth.home() }}" class="tx-btn tx-btn-primary tx-btn-lg">{{ Auth.isStaff() ? "Open the console" : "Go to my portal" }} <IconArrowRight /></a>
{{#else}}
        <a href="/login" class="tx-btn tx-btn-primary tx-btn-lg">Sign in <IconArrowRight /></a>
        <a href="/register" class="tx-btn tx-btn-outline tx-btn-lg">Become a client</a>
{{/if}}
      </div>
      <p class="fade-up fade-up-4 mt-6 text-xs text-muted flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <span class="inline-flex items-center gap-1.5"><IconCheck class="w-3.5 h-3.5 text-brand" /> Response times you can see</span>
        <span class="inline-flex items-center gap-1.5"><IconCheck class="w-3.5 h-3.5 text-brand" /> Projects tracked milestone by milestone</span>
        <span class="inline-flex items-center gap-1.5"><IconCheck class="w-3.5 h-3.5 text-brand" /> Invoices paid by M-Pesa</span>
      </p>
    </div>

    <div class="relative tx-container mt-14 sm:mt-20">
      <div class="relative mx-auto max-w-6xl fade-up fade-up-4">
        <div class="frame !rounded-[20px]">
          <div class="frame-bar !py-2.5"><i></i><i></i><i></i><span class="mx-auto text-[11px] font-mono text-muted hidden sm:block">portal.ashmif.com/overview</span></div>
          <div class="grid grid-cols-[3.25rem_1fr] sm:grid-cols-[13rem_1fr] min-h-[24rem] text-left">
            <aside class="border-r border-line bg-panel p-2 sm:p-3 space-y-0.5">
              <div class="flex items-center gap-2 px-2 py-2 mb-2"><span class="aos-mark h-6 text-brand"></span></div>
              <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg bg-brand-soft/10 text-ink text-[13px] font-medium"><IconLayoutDashboard class="w-4 h-4 text-brand shrink-0" /><span class="hidden sm:inline">Overview</span></div>
              <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg text-soft text-[13px]"><IconTicket class="w-4 h-4 text-muted shrink-0" /><span class="hidden sm:inline">Support tickets</span></div>
              <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg text-soft text-[13px]"><IconMessageCircle class="w-4 h-4 text-muted shrink-0" /><span class="hidden sm:inline">Messages</span><span class="hidden sm:inline-flex ml-auto app-nav-count">2</span></div>
              <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg text-soft text-[13px]"><IconPackage class="w-4 h-4 text-muted shrink-0" /><span class="hidden sm:inline">Services</span></div>
              <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg text-soft text-[13px]"><IconKanban class="w-4 h-4 text-muted shrink-0" /><span class="hidden sm:inline">Projects</span></div>
              <div class="flex items-center gap-2.5 px-2 py-2 rounded-lg text-soft text-[13px]"><IconReceipt class="w-4 h-4 text-muted shrink-0" /><span class="hidden sm:inline">Billing</span></div>
            </aside>
            <div class="bg-canvas p-4 sm:p-6 min-w-0">
              <div class="flex items-center justify-between gap-3">
                <div class="min-w-0"><p class="text-xs text-muted">Good morning, Amina</p><p class="text-lg sm:text-xl font-bold tracking-tight truncate">Coastline Clinics</p></div>
                <div class="flex items-center gap-2">
                  <span class="hidden md:flex items-center gap-2 h-8 px-3 rounded-full border border-line bg-panel text-xs text-muted"><IconSearch class="w-3.5 h-3.5" /> Search <span class="kbd">⌘K</span></span>
                  <span class="relative tx-icon-btn !w-8 !h-8 border border-line bg-panel"><IconBell class="!w-4 !h-4" /><span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-coral"></span></span>
                  <span class="avatar w-8 h-8 text-[11px]">AO</span>
                </div>
              </div>
              <div class="mt-5 grid grid-cols-2 lg:grid-cols-4 gap-3">
                <div class="tx-panel-flat p-3.5"><p class="text-[11px] text-muted flex items-center gap-1.5"><IconTicket class="w-3.5 h-3.5 text-sky" /> Open tickets</p><p class="mt-1.5 text-2xl font-bold tabular">2</p></div>
                <div class="tx-panel-flat p-3.5"><p class="text-[11px] text-muted flex items-center gap-1.5"><IconReceipt class="w-3.5 h-3.5 text-peach" /> Balance due</p><p class="mt-1.5 text-2xl font-bold tabular">14,999</p></div>
                <div class="tx-panel-flat p-3.5"><p class="text-[11px] text-muted flex items-center gap-1.5"><IconClock class="w-3.5 h-3.5 text-brand" /> Avg first reply</p><p class="mt-1.5 text-2xl font-bold tabular">38m</p></div>
                <div class="tx-panel-flat p-3.5"><p class="text-[11px] text-muted flex items-center gap-1.5"><IconMessagesSquare class="w-3.5 h-3.5 text-violet" /> SMS delivered</p><p class="mt-1.5 text-2xl font-bold tabular">{{ delivered.toLocaleString() }}</p></div>
              </div>
              <div class="mt-3 grid lg:grid-cols-[1.4fr_1fr] gap-3">
                <div class="tx-panel-flat overflow-hidden">
                  <p class="px-4 py-2.5 text-xs font-semibold border-b border-line">Recent tickets</p>
                  <div class="shot-row"><span class="w-2 h-2 rounded-full bg-peach"></span><span class="flex-1 truncate font-medium">Lab results not printing</span><span class="tx-badge tone-peach">Awaiting you</span></div>
                  <div class="shot-row"><span class="w-2 h-2 rounded-full bg-sky"></span><span class="flex-1 truncate font-medium">Add two pharmacy users</span><span class="tx-badge tone-sky">In progress</span></div>
                  <div class="shot-row"><span class="w-2 h-2 rounded-full bg-mint"></span><span class="flex-1 truncate font-medium">SHA claims export</span><span class="tx-badge tone-mint">Resolved</span></div>
                </div>
                <div class="tx-panel-flat p-4">
                  <p class="text-xs font-semibold">Patient app, phase 2</p>
                  <div class="mt-3 flex items-center gap-3"><div class="tx-progress flex-1"><span style="width:68%"></span></div><span class="text-xs text-muted tabular">68%</span></div>
                  <ul class="mt-3 space-y-1.5 text-[11px] text-soft list-none p-0">
                    <li class="flex items-center gap-2"><IconCheckCircle class="w-3.5 h-3.5 text-mint" /> Booking & reminders</li>
                    <li class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-full border-2 border-brand border-r-transparent"></span> Lab results</li>
                    <li class="flex items-center gap-2 text-muted"><span class="w-3.5 h-3.5 rounded-full border border-line-strong"></span> M-Pesa checkout</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="hidden md:flex absolute -left-6 lg:-left-12 top-24 w-72 tx-panel !rounded-2xl p-3.5 items-center gap-3 shadow-2xl">
          <span class="{{ 'tx-stat-icon !w-10 !h-10 !rounded-xl shrink-0 text-white ' + (toast.icon is 'pay' ? 'bg-mint' : toast.icon is 'ok' ? 'bg-sky' : 'bg-peach') }}">
{{#if toast.icon is "pay"}}<IconMobileMoney class="!w-5 !h-5" />{{#else if toast.icon is "ok"}}<IconCheckCircle class="!w-5 !h-5" />{{#else}}<IconBell class="!w-5 !h-5" />{{/if}}
          </span>
          <div class="min-w-0 text-left"><p class="text-sm font-semibold">{{ toast.title }}</p><p class="text-xs text-muted truncate">{{ toast.body }}</p></div>
          <span class="ml-auto text-[10px] text-muted">now</span>
        </div>

        <div class="hidden md:block absolute -right-6 lg:-right-12 -bottom-10 w-80 tx-panel !rounded-2xl overflow-hidden shadow-2xl text-left">
          <div class="px-4 py-3 border-b border-line flex items-center gap-3">
            <span class="relative w-9 h-9 rounded-xl bg-[#07090d] flex items-center justify-center"><span class="aos-mark h-5 text-[#18c192]"></span><span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-mint border-2 border-panel"></span></span>
            <div><p class="text-sm font-semibold">Ashmif Support</p><p class="text-[11px] text-muted">Online · replies in minutes</p></div>
          </div>
          <div class="p-3.5 space-y-2.5">
            <div class="bubble bubble-me !text-xs ml-auto w-fit">Can we export this month's SHA claims?</div>
            <div class="flex gap-2"><span class="avatar avatar-staff w-6 h-6 text-[9px]">FS</span><div class="bubble bubble-them !text-xs">Yes! Billing → Claims → Export. Want me to walk you through it?</div></div>
          </div>
          <div class="px-3.5 pb-3.5"><div class="h-9 rounded-full border border-line flex items-center justify-between pl-3.5 pr-1 text-xs text-muted">Type a message…<span class="w-7 h-7 rounded-full bg-brand flex items-center justify-center"><IconSend class="w-3.5 h-3.5 text-brand-on" /></span></div></div>
        </div>
      </div>
    </div>
    <div class="h-20 sm:h-28"></div>
  </section>

  <section class="border-y border-line bg-panel/60">
    <div class="tx-container py-8 grid gap-5 lg:grid-cols-[14rem_1fr] items-center">
      <p class="font-mono text-xs text-muted leading-relaxed text-center lg:text-left"><span class="text-brand">❯</span> we ship in<br class="hidden lg:block" /> <span class="text-ink">the stacks business runs on</span></p>
      <div class="logo-rail" aria-label="Technologies we build with">
        <div class="marquee">
{{#each l in rail}}
          <span class="logo-chip"><span class="logo-chip-tile">{{#if l.id is "tylix"}}<span class="tylix-mark w-[1.125rem] text-[#3563ff]"></span>{{#else if l.id is "flux"}}<img src="/brand/flux-mark.svg" alt="" class="rounded" />{{#else}}<img src="{{ '/logos/' + l.id + '.svg' }}" alt="" />{{/if}}</span>{{ l.name }}</span>
{{/each}}
{{#each l in rail}}
          <span class="logo-chip" aria-hidden="true"><span class="logo-chip-tile">{{#if l.id is "tylix"}}<span class="tylix-mark w-[1.125rem] text-[#3563ff]"></span>{{#else if l.id is "flux"}}<img src="/brand/flux-mark.svg" alt="" class="rounded" />{{#else}}<img src="{{ '/logos/' + l.id + '.svg' }}" alt="" />{{/if}}</span>{{ l.name }}</span>
{{/each}}
        </div>
      </div>
    </div>
  </section>

  <section class="tx-container py-20 sm:py-28" id="products">
    <div class="max-w-3xl reveal">
      <p class="prompt-eyebrow mb-4"><span>~/</span><b>products</b></p>
      <h2 class="section-title">Eight products. One team that answers for all of them.</h2>
      <p class="mt-4 text-lg text-soft max-w-2xl">Each one solves a real East African workflow end to end, and every client gets the same portal, the same support and the same people.</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <a href="/products/medisynq" class="reveal tx-panel tx-hover p-6 no-underline text-ink flex flex-col lg:col-span-2">
        <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-semibold text-[#0ea5e9]">Healthcare</p><h3 class="mt-1 text-xl font-bold">MediSynq</h3><p class="mt-1.5 text-sm text-soft max-w-md">The whole patient visit in one system: reception, triage, lab, pharmacy and billing with M-Pesa and SHA claims.</p></div><span class="product-icon shrink-0 bg-[#0ea5e9]/10 text-[#0ea5e9]"><ProductIcon slug="medisynq" cls="w-6 h-6" /></span></div>
        <div class="mt-6 shot">
          <div class="shot-bar"><i></i><i></i><i></i><span class="ml-2 text-[10px] text-muted font-mono">Live queue · Outpatient</span></div>
          <div class="shot-row"><span class="font-mono text-muted w-10">#014</span><span class="flex-1 font-medium">Fatuma H.</span><span class="hidden sm:inline text-muted">BP 128/84 · 36.9°C</span><span class="tx-badge tone-violet">With doctor</span></div>
          <div class="shot-row"><span class="font-mono text-muted w-10">#015</span><span class="flex-1 font-medium">Brian O.</span><span class="hidden sm:inline text-muted">Full haemogram</span><span class="tx-badge tone-sky">In lab</span></div>
          <div class="shot-row"><span class="font-mono text-muted w-10">#016</span><span class="flex-1 font-medium">Salma K.</span><span class="hidden sm:inline text-muted">Amoxicillin 500mg</span><span class="tx-badge tone-peach">Pharmacy</span></div>
          <div class="shot-row"><span class="font-mono text-muted w-10">#017</span><span class="flex-1 font-medium">John M.</span><span class="hidden sm:inline text-muted">KES 2,400 · M-Pesa</span><span class="tx-badge tone-mint">Paid</span></div>
        </div>
      </a>

      <a href="/products/sms" class="reveal reveal-d1 tx-panel tx-hover p-6 no-underline text-ink flex flex-col">
        <div class="flex items-start justify-between gap-4"><div><p class="text-xs font-semibold text-brand">Messaging</p><h3 class="mt-1 text-xl font-bold">Ashmif SMS</h3><p class="mt-1.5 text-sm text-soft">Bulk SMS under your own Sender ID.</p></div><span class="product-icon shrink-0 bg-brand-soft/10 text-brand"><ProductIcon slug="sms" cls="w-6 h-6" /></span></div>
        <div class="mt-6 shot p-4 flex-1 flex flex-col justify-between">
          <div class="flex items-center justify-between text-[11px]"><span class="font-mono font-semibold">COASTLINE</span><span class="flex items-center gap-1.5 text-mint"><span class="tx-live"></span> Sending</span></div>
          <p class="mt-4 text-3xl font-bold tabular tracking-tight">{{ sent.toLocaleString() }}</p>
          <p class="text-[11px] text-muted">messages sent · {{ rate }}% delivered</p>
          <div class="mt-3 tx-progress"><span style:width="{{ rate + '%' }}"></span></div>
        </div>
      </a>

