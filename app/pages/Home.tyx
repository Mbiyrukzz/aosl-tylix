  <section class="band-dark" id="engineering">
    <div class="absolute inset-0 bg-grid mask-fade-b opacity-60"></div>
    <div class="relative tx-container py-20 sm:py-28">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end reveal">
        <div class="max-w-3xl">
          <p class="prompt-eyebrow !text-white/50 mb-4"><span>~/</span><b class="!text-[#18c192]">engineering</b></p>
          <h2 class="section-title text-white">Many languages. <span class="text-[#18c192]">One engineering standard.</span></h2>
          <p class="mt-5 text-lg text-white/65 leading-relaxed max-w-2xl">We ship production systems in Next.js, Java, PHP, Python and Tylix, our own open-source framework. We pick what fits the problem and your team, and we're just as happy working in the codebase you already have.</p>
        </div>
        <a href="/contact?topic=project" class="tx-btn tx-btn-lg !bg-white !text-[#07090d] self-start lg:self-auto">Talk to an engineer <IconArrowRight /></a>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[22rem_1fr] reveal reveal-d1">
        <div class="grid gap-2 content-start" role="tablist" aria-label="Stacks">
          <button type="button" role="tab" aria-selected="{{ eng is 'next' }}" class="eng-tab" class:eng-tab-on="{{ eng is 'next' }}" onclick="{{ eng = 'next' }}">
            <span class="eng-tile"><img src="/logos/nextjs.svg" alt="" /></span>
            <span class="min-w-0"><span class="block font-semibold">Next.js &amp; React</span><span class="block text-xs text-white/50 mt-0.5">Web apps, portals and storefronts</span></span>
          </button>
          <button type="button" role="tab" aria-selected="{{ eng is 'java' }}" class="eng-tab" class:eng-tab-on="{{ eng is 'java' }}" onclick="{{ eng = 'java' }}">
            <span class="eng-tile"><img src="/logos/java.svg" alt="" /></span>
            <span class="min-w-0"><span class="block font-semibold">Java &amp; Spring</span><span class="block text-xs text-white/50 mt-0.5">Enterprise services and integrations</span></span>
          </button>
          <button type="button" role="tab" aria-selected="{{ eng is 'tylix' }}" class="eng-tab" class:eng-tab-on="{{ eng is 'tylix' }}" onclick="{{ eng = 'tylix' }}">
            <span class="eng-tile"><span class="tylix-mark w-5 text-[#3563ff]"></span></span>
            <span class="min-w-0"><span class="block font-semibold">Tylix</span><span class="block text-xs text-white/50 mt-0.5">Our framework: Flux, the portal, this site</span></span>
          </button>
          <button type="button" role="tab" aria-selected="{{ eng is 'yours' }}" class="eng-tab" class:eng-tab-on="{{ eng is 'yours' }}" onclick="{{ eng = 'yours' }}">
            <span class="eng-tile"><IconCode class="w-5 h-5 text-[#07090d]" /></span>
            <span class="min-w-0"><span class="block font-semibold">Your codebase</span><span class="block text-xs text-white/50 mt-0.5">PHP, Python, .NET, Node.js and more</span></span>
          </button>

          <div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm text-white/70 leading-relaxed">
{{#if eng is "next"}}
            <p class="text-white font-semibold">Fast on every connection.</p>
            <p class="mt-2">Server rendering, caching and typed APIs for sites and dashboards that stay quick on patchy mobile data, with M-Pesa checkout built in.</p>
{{#else if eng is "java"}}
            <p class="text-white font-semibold">Built to be correct, every time.</p>
            <p class="mt-2">Spring Boot services for organisations where money and records move: integrations, batch jobs and APIs with tests that run on every change.</p>
{{#else if eng is "tylix"}}
            <p class="text-white font-semibold">Our own open-source, MIT-licensed framework.</p>
            <p class="mt-2">Pages, API, auth, ORM, jobs and mail already wired together. Because we maintain it, a fix lands in days, not whenever someone else's roadmap allows.</p>
            <div class="mt-4 flex flex-wrap gap-2"><a href="/products/tylix" class="eng-chip">Tylix</a><a href="/products/flux" class="eng-chip">Tylix Flux</a><a href="https://tylix.dev" target="_blank" rel="noopener" class="eng-chip">tylix.dev <IconArrowUpRight class="w-3 h-3" /></a></div>
{{#else}}
            <p class="text-white font-semibold">We work in the code you already have.</p>
            <p class="mt-2">Taking over an app another team left behind, adding a mobile app to an old backend or speeding up a slow site is everyday work. No rewrite unless it truly pays off.</p>
            <div class="mt-4 flex flex-wrap gap-2"><a href="/services#stack" class="eng-chip">Every technology we use <IconArrowRight class="w-3 h-3" /></a></div>
{{/if}}
          </div>
        </div>

        <div class="min-w-0 term">
          <div class="term-bar"><i></i><i></i><i></i><span class="term-title truncate">{{ eng is "next" ? "app/invoices/page.tsx" : eng is "java" ? "src/main/java/claims/ClaimsController.java" : eng is "tylix" ? "app/pages/portal/Index.tyx" : "flux deploy" }}</span></div>
{{#if eng is "next"}}
          <div class="code p-5 sm:p-6 overflow-x-auto text-white/85 whitespace-nowrap min-h-[22rem]">
            <div><span class="k">export default async function</span> <span class="f">InvoicesPage</span>() {</div>
            <div class="pl-6"><span class="k">const</span> invoices = <span class="k">await</span> db.invoice.<span class="f">findMany</span>({</div>
            <div class="pl-12">where: { status: <span class="s">"unpaid"</span> },</div>
            <div class="pl-12">orderBy: { dueAt: <span class="s">"asc"</span> },</div>
            <div class="pl-6">})</div>
            <div>&nbsp;</div>
            <div class="pl-6"><span class="k">return</span> (</div>
            <div class="pl-12">&lt;<span class="n">InvoiceTable</span> rows={invoices} onPay={<span class="f">payWithMpesa</span>} /&gt;</div>
            <div class="pl-6">)</div>
            <div>}</div>
          </div>
{{#else if eng is "java"}}
          <div class="code p-5 sm:p-6 overflow-x-auto text-white/85 whitespace-nowrap min-h-[22rem]">
            <div><span class="t">@RestController</span></div>
            <div><span class="t">@RequestMapping</span>(<span class="s">"/api/claims"</span>)</div>
            <div><span class="k">class</span> <span class="n">ClaimsController</span> {</div>
            <div>&nbsp;</div>
            <div class="pl-6"><span class="k">private final</span> <span class="n">ClaimService</span> claims;</div>
            <div>&nbsp;</div>
            <div class="pl-6"><span class="t">@PostMapping</span></div>
            <div class="pl-6"><span class="n">ResponseEntity</span>&lt;<span class="n">Claim</span>&gt; <span class="f">submit</span>(<span class="t">@Valid @RequestBody</span> <span class="n">ClaimRequest</span> req) {</div>
            <div class="pl-12"><span class="n">Claim</span> claim = claims.<span class="f">submit</span>(req);</div>
            <div class="pl-12"><span class="k">return</span> <span class="n">ResponseEntity</span>.<span class="f">status</span>(CREATED).<span class="f">body</span>(claim);</div>
            <div class="pl-6">}</div>
            <div>}</div>
          </div>
{{#else if eng is "tylix"}}
          <div class="code p-5 sm:p-6 overflow-x-auto text-white/85 whitespace-nowrap min-h-[22rem]">
            <div><span class="k">page</span> PortalHome</div>
            <div>&nbsp;</div>
            <div><span class="k">uses</span></div>
            <div class="pl-4">Auth</div>
            <div>&nbsp;</div>
            <div><span class="k">state</span></div>
            <div class="pl-4">tickets: []</div>
            <div>&nbsp;</div>
            <div><span class="k">onMount</span></div>
            <div class="pl-4"><span class="k">async</span> {</div>
            <div class="pl-8"><span class="k">const</span> r = <span class="k">await</span> <span class="f">useApi</span>(<span class="s">"/api/portal/tickets"</span>)</div>
            <div class="pl-8">this.tickets = r.data</div>
            <div class="pl-4">}</div>
          </div>
{{#else}}
          <div class="code p-5 sm:p-6 overflow-x-auto text-white/80 whitespace-nowrap min-h-[22rem]">
            <p class="m-0"><span class="t-p">❯</span> flux deploy shop-web</p>
            <p class="m-0 text-white/50">→ detected Next.js 15 · Node 22</p>
            <p class="m-0 text-white/50">→ npm ci · next build</p>
            <p class="m-0"><span class="s">✔ Live</span> on app-prod-1 in 41s</p>
            <p class="m-0">&nbsp;</p>
            <p class="m-0"><span class="t-p">❯</span> flux deploy claims-api</p>
            <p class="m-0 text-white/50">→ detected Spring Boot 3 · Java 21</p>
            <p class="m-0 text-white/50">→ ./mvnw package</p>
            <p class="m-0"><span class="s">✔ Live</span> on app-prod-2 in 66s</p>
            <p class="m-0">&nbsp;</p>
            <p class="m-0"><span class="t-p">❯</span> flux deploy clinic-reports</p>
            <p class="m-0 text-white/50">→ detected Django 5 · Python 3.12</p>
            <p class="m-0"><span class="s">✔ Live</span> on app-prod-2 <span class="caret"></span></p>
          </div>
{{/if}}
        </div>
      </div>

      <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 border-t border-white/10 reveal">
        <div class="pt-8 pr-4"><p class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-mono">16</p><p class="mt-1.5 text-sm text-white/55">stacks Tylix Flux deploys from Git</p></div>
        <div class="pt-8 pr-4 lg:border-l lg:pl-8 border-white/10"><p class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-mono">7</p><p class="mt-1.5 text-sm text-white/55">cloud providers we can run your app on</p></div>
        <div class="pt-8 pr-4 lg:border-l lg:pl-8 border-white/10"><p class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-mono">MIT</p><p class="mt-1.5 text-sm text-white/55">licence on the framework we maintain</p></div>
        <div class="pt-8 pr-4 lg:border-l lg:pl-8 border-white/10"><p class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-mono">EAT</p><p class="mt-1.5 text-sm text-white/55">engineers in your time zone, in Mombasa</p></div>
      </div>
    </div>
  </section>

  <section class="tx-container py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal lg:sticky lg:top-24 self-start">
        <p class="prompt-eyebrow mb-4"><span>~/</span><b>reliability</b></p>
        <h2 class="section-title">For organisations that can't afford to stop</h2>
        <p class="mt-5 text-lg text-soft">Hospitals, schools and payroll teams run their day on our software. These are the commitments behind it.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/status" class="tx-btn tx-btn-outline"><span class="tx-live text-mint"></span> System status</a>
          <a href="/services#plans" class="tx-btn tx-btn-ghost">Support plans <IconArrowRight /></a>
        </div>
      </div>
      <div class="grid gap-px rounded-3xl overflow-hidden border border-line bg-line sm:grid-cols-2">
        <div class="bg-panel p-7 reveal"><IconClock class="w-6 h-6 text-brand" /><p class="mt-5 text-3xl font-bold tracking-tight">2h<span class="text-base font-semibold text-muted"> / 8h / 24h</span></p><p class="mt-2 font-semibold">First-response targets</p><p class="mt-1 text-sm text-muted leading-relaxed">Set by your plan and shown on every ticket, so you always know when we'll reply.</p></div>
        <div class="bg-panel p-7 reveal reveal-d1"><IconShieldCheck class="w-6 h-6 text-brand" /><p class="mt-5 font-semibold">Secure by default</p><p class="mt-1 text-sm text-muted leading-relaxed">Role-based access for every user and sessions you can revoke from your portal.</p></div>
        <div class="bg-panel p-7 reveal"><IconMobileMoney class="w-6 h-6 text-brand" /><p class="mt-5 font-semibold">Kenyan compliance built in</p><p class="mt-1 text-sm text-muted leading-relaxed">M-Pesa, PAYE, NSSF, SHIF, the Housing Levy and SHA claims handled in the product, not in a spreadsheet.</p></div>
        <div class="bg-panel p-7 reveal reveal-d1"><IconServer class="w-6 h-6 text-brand" /><p class="mt-5 font-semibold">Your cloud or ours</p><p class="mt-1 text-sm text-muted leading-relaxed">We host it for you, or deploy to your own AWS, DigitalOcean or Hetzner account with Tylix Flux.</p></div>
        <div class="bg-panel p-7 reveal"><IconUsers class="w-6 h-6 text-brand" /><p class="mt-5 font-semibold">A named account manager</p><p class="mt-1 text-sm text-muted leading-relaxed">On Gold and Platinum, one person who knows your setup and your team.</p></div>
        <div class="bg-panel p-7 reveal reveal-d1"><IconMapPin class="w-6 h-6 text-brand" /><p class="mt-5 font-semibold">In your time zone</p><p class="mt-1 text-sm text-muted leading-relaxed">Engineers and support in Mombasa, six days a week, 8am to 6pm EAT.</p></div>
      </div>
    </div>
  </section>

  <section class="tx-container py-20 sm:py-28">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-14 reveal">
      <div class="max-w-2xl">
        <p class="prompt-eyebrow mb-4"><span>~/</span><b>custom-software</b></p>
        <h2 class="section-title">When nothing off the shelf fits, <span class="text-brand">we build it</span></h2>
      </div>
      <a href="/services" class="tx-btn tx-btn-outline self-start lg:self-auto">Our services <IconArrowRight /></a>
    </div>
    <ol class="pipe grid gap-10 lg:gap-6 lg:grid-cols-4 list-none p-0 m-0">
{{#each st, i in steps}}
      <li class="{{ 'flex lg:block gap-5 reveal reveal-d' + Math.min(3, i) }}">
        <span class="pipe-dot" class:pipe-dot-done="{{ i < 2 }}">{{ st.n }}</span>
        <div class="lg:mt-6 min-w-0">
          <h3 class="text-xl font-bold tracking-tight">{{ st.title }}</h3>
          <p class="mt-2 text-sm text-soft leading-relaxed">{{ st.body }}</p>
          <p class="mt-3 font-mono text-xs" class:text-brand="{{ i < 3 }}" class:text-muted="{{ i is 3 }}">{{ st.log }}</p>
        </div>
      </li>
{{/each}}
    </ol>
  </section>

  <section class="tx-container pb-6">
    <div class="tx-panel-flat p-6 sm:p-8 grid gap-6 md:grid-cols-[auto_1fr_auto] items-center reveal">
      <span class="group-mark w-14 h-14"></span>
      <div>
        <p class="tx-kicker !text-gold">Part of Ashmif Group</p>
        <p class="mt-1.5 text-lg font-semibold tracking-tight">One group, one standard of care, across every Ashmif company.</p>
