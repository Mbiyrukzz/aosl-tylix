              <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-brand-soft/10 font-medium"><span class="flex items-center gap-2"><IconInbox class="w-4 h-4 text-brand" /> Inbox</span><span class="text-xs font-semibold text-brand">4</span></div>
