page Register

import { IconArrowRight, IconMailOpen } from "tylix-icons"

title "Create your client account · Ashmif"

needs
  Auth

uses
  Live

state
  name: ""
  company: ""
  phone: ""
  email: ""
  password: ""
  agreed: false
  error: ""
  submitting: false
  registered: false

computed
  strength() {
    const p = this.password
    if p.length < 8 {
      return 0
    }
    let score = 1
    if /[a-z]/.test(p) and /[A-Z]/.test(p) {
      score += 1
    }
    if /[0-9]/.test(p) {
      score += 1
    }
    if /[^A-Za-z0-9]/.test(p) or p.length >= 14 {
      score += 1
    }
    return score
  }

  strengthLabel() {
    return ["Too short", "Weak", "Fair", "Good", "Strong"][this.strength]
  }

action
  validate() {
    if not this.name.trim() {
      return "Enter your name."
    }
    if not this.company.trim() {
      return "Enter your company or organisation."
    }
    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      return "Enter a valid email address."
    }
    if this.password.length < 8 {
      return "Use at least 8 characters for your password."
    }
    if not this.agreed {
      return "Please accept the terms to continue."
    }
    return ""
  }

  async submit() {
    if this.submitting {
      return null
    }
    this.error = this.validate()
    if this.error {
      return null
    }
    this.submitting = true
    const r = await useApi("/api/register", { method: "POST", body: { name: this.name, company: this.company, phone: this.phone, email: this.email, password: this.password } })
    this.submitting = false
    if r.ok {
      this.registered = true
    } else {
      this.error = Live.errorOf(r, "Couldn't create the account. Check your details and try again.")
    }
  }

onMount
  {
    if Auth.user {
      window.location.href = Auth.home()
    }
  }

template
  <AuthFrame heading="Your account, your team, one portal" subheading="Create a client account for your company. Add teammates later, and we'll link your existing services.">
    <div class="lg:hidden mb-8"><BrandLogo /></div>
{{#if registered}}
    <div class="text-center py-6">
      <span class="mx-auto w-14 h-14 rounded-2xl bg-brand-soft/15 text-brand flex items-center justify-center"><IconMailOpen class="w-7 h-7" /></span>
      <h1 class="mt-5 text-2xl font-bold tracking-tight">Check your inbox</h1>
      <p class="text-sm text-muted mt-2 leading-relaxed">We sent a verification link to <strong class="text-ink">{{ email }}</strong>. Open it, then sign in to your portal.</p>
      <a href="/login" class="tx-btn tx-btn-primary mt-7">Go to sign in <IconArrowRight /></a>
    </div>
{{#else}}
    <h1 class="text-2xl font-bold tracking-tight">Create a client account</h1>
    <p class="text-sm text-muted mt-1 mb-7">Takes a minute. No card needed.</p>
{{#if error}}
    <div class="tx-alert tx-alert-error mb-5" role="alert"><p>{{ error }}</p></div>
{{/if}}
    <OAuthButtons returnTo="{{ '/portal' }}" />
    <form onsubmit.prevent="{{ submit() }}" novalidate>
      <div class="grid sm:grid-cols-2 gap-x-3">
        <div class="tx-field">
          <label for="name" class="tx-label">Your name</label>
          <input id="name" autocomplete="name" class="tx-input" placeholder="Amina Odhiambo" bind:value="{{ name }}" />
        </div>
        <div class="tx-field">
          <label for="phone" class="tx-label">Phone <span class="text-muted font-normal">(optional)</span></label>
          <input id="phone" type="tel" autocomplete="tel" class="tx-input" placeholder="+254 7…" bind:value="{{ phone }}" />
        </div>
      </div>
      <div class="tx-field">
        <label for="company" class="tx-label">Company or organisation</label>
        <input id="company" autocomplete="organization" class="tx-input" placeholder="Coastline Clinics Ltd" bind:value="{{ company }}" />
      </div>
      <div class="tx-field">
        <label for="email" class="tx-label">Work email</label>
        <input id="email" type="email" autocomplete="email" class="tx-input" placeholder="you@company.co.ke" bind:value="{{ email }}" />
      </div>
      <div class="tx-field">
        <label for="password" class="tx-label">Password</label>
        <input id="password" type="password" autocomplete="new-password" class="tx-input" placeholder="At least 8 characters" bind:value="{{ password }}" />
{{#if password}}
        <div class="mt-2 flex items-center gap-2">
          <div class="flex-1 grid grid-cols-4 gap-1">
            <span class="h-1 rounded-full" class:bg-coral="{{ strength is 1 }}" class:bg-peach="{{ strength is 2 }}" class:bg-brand="{{ strength >= 3 }}" class:bg-line="{{ strength < 1 }}"></span>
            <span class="h-1 rounded-full" class:bg-peach="{{ strength is 2 }}" class:bg-brand="{{ strength >= 3 }}" class:bg-line="{{ strength < 2 }}"></span>
            <span class="h-1 rounded-full" class:bg-brand="{{ strength >= 3 }}" class:bg-line="{{ strength < 3 }}"></span>
            <span class="h-1 rounded-full" class:bg-brand="{{ strength >= 4 }}" class:bg-line="{{ strength < 4 }}"></span>
          </div>
          <span class="text-[11px] text-muted w-16 text-right">{{ strengthLabel }}</span>
        </div>
{{/if}}
      </div>
      <label class="flex items-start gap-2 text-sm text-soft mb-6"><input type="checkbox" class="tx-check mt-0.5" bind:checked="{{ agreed }}" /> <span>I agree to Ashmif's terms of service and privacy policy.</span></label>
      <button type="submit" class="tx-btn tx-btn-primary tx-btn-block tx-btn-lg" disabled="{{ submitting }}">
{{#if submitting}}<span class="tx-spinner"></span> Creating account…{{#else}}Create account <IconArrowRight />{{/if}}
      </button>
    </form>
    <p class="text-sm text-muted text-center mt-7">Already have an account? <a href="/login" class="tx-link">Sign in</a></p>
{{/if}}
  </AuthFrame>
