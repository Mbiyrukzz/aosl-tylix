component CompanyForm

// Create or edit a client company (console). Calls onSaved(company).

props
  company: Object
  staff: any[]
  onSaved: Function
  onCancel: Function

uses
  Live

state
  form: { name: "", email: "", phone: "", website: "", address: "", kra_pin: "", industry: "", tier: "silver", status: "active", account_manager_id: "", notes: "" }
  saving: false
  error: ""

action
  async save() {
    this.error = ""
    if not this.form.name.trim() {
      this.error = "Company name is required."
      return null
    }
    this.saving = true
    const r = this.company ? await useApi(`/api/admin/companies/${this.company.id}`, { method: "PUT", body: this.form }) : await useApi("/api/admin/companies", { method: "POST", body: this.form })
    this.saving = false
    if r.ok {
      this.onSaved(r.data)
    } else {
      this.error = Live.errorOf(r, "Couldn't save.")
    }
  }

onMount
  {
    const c = this.company
    if c {
      this.form = { name: c.name ?? "", email: c.email ?? "", phone: c.phone ?? "", website: c.website ?? "", address: c.address ?? "", kra_pin: c.kra_pin ?? "", industry: c.industry ?? "", tier: c.tier ?? "silver", status: c.status ?? "active", account_manager_id: c.account_manager_id ? String(c.account_manager_id) : "", notes: c.notes ?? "" }
    }
  }

template
  <form onsubmit.prevent="{{ save() }}" novalidate>
{{#if error}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p>{{ error }}</p></div>{{/if}}
    <div class="grid sm:grid-cols-2 gap-x-4">
      <div class="tx-field sm:col-span-2"><label class="tx-label" for="cf-name">Company name</label><input id="cf-name" class="tx-input" bind:value="{{ form.name }}" /></div>
      <div class="tx-field"><label class="tx-label" for="cf-tier">Support tier</label><select id="cf-tier" class="tx-input" bind:value="{{ form.tier }}"><option value="silver">Silver · 24h</option><option value="gold">Gold · 8h</option><option value="platinum">Platinum · 2h</option></select></div>
      <div class="tx-field"><label class="tx-label" for="cf-status">Status</label><select id="cf-status" class="tx-input" bind:value="{{ form.status }}"><option value="onboarding">Onboarding</option><option value="active">Active</option><option value="on_hold">On hold</option><option value="archived">Archived</option></select></div>
      <div class="tx-field"><label class="tx-label" for="cf-email">Billing email</label><input id="cf-email" type="email" class="tx-input" bind:value="{{ form.email }}" /></div>
      <div class="tx-field"><label class="tx-label" for="cf-phone">Phone</label><input id="cf-phone" class="tx-input" bind:value="{{ form.phone }}" /></div>
      <div class="tx-field"><label class="tx-label" for="cf-kra">KRA PIN</label><input id="cf-kra" class="tx-input font-mono uppercase" bind:value="{{ form.kra_pin }}" /></div>
      <div class="tx-field"><label class="tx-label" for="cf-ind">Industry</label><input id="cf-ind" class="tx-input" bind:value="{{ form.industry }}" /></div>
      <div class="tx-field"><label class="tx-label" for="cf-web">Website</label><input id="cf-web" class="tx-input" bind:value="{{ form.website }}" /></div>
      <div class="tx-field"><label class="tx-label" for="cf-addr">Address</label><input id="cf-addr" class="tx-input" bind:value="{{ form.address }}" /></div>
      <div class="tx-field sm:col-span-2"><label class="tx-label" for="cf-mgr">Account manager</label><select id="cf-mgr" class="tx-input" bind:value="{{ form.account_manager_id }}"><option value="">None</option>{{#each s in staff}}<option value="{{ String(s.id) }}">{{ s.name }}</option>{{/each}}</select></div>
      <div class="tx-field sm:col-span-2"><label class="tx-label" for="cf-notes">Internal notes <span class="text-muted font-normal">(staff only)</span></label><textarea id="cf-notes" rows="3" class="tx-input" bind:value="{{ form.notes }}"></textarea></div>
    </div>
    <div class="flex justify-end gap-2"><button type="button" class="tx-btn tx-btn-ghost" onclick="{{ onCancel() }}">Cancel</button><button type="submit" class="tx-btn tx-btn-primary" disabled="{{ saving }}">{{ saving ? "Saving…" : company ? "Save changes" : "Add company" }}</button></div>
  </form>
