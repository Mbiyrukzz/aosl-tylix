component SettingsPanel

import { IconSave, IconCamera, IconKey, IconLogout, IconDeviceMobile, IconDesktopComputer, IconBell, IconPalette, IconTrash } from "tylix-icons"

// Profile, theme, notification preferences, password and sessions.
// Used by /portal/settings and /admin/settings.

uses
  Auth
  Live
  Fmt

state
  profile: { name: "", phone: "", job_title: "", avatar_url: null, notify_email: true, notify_sms: false }
  saving: false
  uploading: false
  pw: { currentPassword: "", password: "", confirm: "" }
  pwError: ""
  pwSaving: false
  sessions: []

action
  async loadSessions() {
    const r = await useApi("/api/auth/sessions")
    if r.ok {
      this.sessions = r.data.sessions ?? r.data.data ?? []
    }
  }

  async save() {
    this.saving = true
    const r = await useApi("/api/account", { method: "PUT", body: this.profile })
    this.saving = false
    if r.ok {
      await Auth.refresh()
      Live.say("Profile saved")
    } else {
      Live.say(Live.errorOf(r, "Couldn't save."))
    }
  }

  pickAvatar(e) {
    const file = e.target.files?.[0]
    if not file {
      return null
    }
    if file.size > 2 * 1024 * 1024 {
      Live.say("Photos must be 2 MB or smaller.")
      return null
    }
    const reader = new FileReader()
    reader.onload = async () => {
      this.uploading = true
      const r = await useApi("/api/uploads", { method: "POST", body: { data: String(reader.result) } })
      this.uploading = false
      if r.ok {
        this.profile.avatar_url = r.data.url
        await this.save()
      } else {
        Live.say(Live.errorOf(r, "Upload failed."))
      }
    }
    reader.readAsDataURL(file)
  }

  async removeAvatar() {
    this.profile.avatar_url = null
    await this.save()
  }

  async changePassword() {
    this.pwError = ""
    if this.pw.password.length < 8 {
      this.pwError = "Use at least 8 characters."
      return null
    }
    if this.pw.password is not this.pw.confirm {
      this.pwError = "The new passwords don't match."
      return null
    }
    this.pwSaving = true
    const r = await useApi("/api/auth/change-password", { method: "POST", body: { currentPassword: this.pw.currentPassword, password: this.pw.password } })
    this.pwSaving = false
    if r.ok {
      this.pw = { currentPassword: "", password: "", confirm: "" }
      Live.say("Password changed. Other devices were signed out.")
      await this.loadSessions()
    } else {
      this.pwError = r.status is 401 ? "Your current password is wrong." : Live.errorOf(r, "Couldn't change the password.")
    }
  }

  async revoke(s) {
    await useApi(`/api/auth/sessions/${s.id}`, { method: "DELETE" })
    await this.loadSessions()
  }

  async signOutEverywhere() {
    if not confirm("Sign out on every device, including this one?") {
      return null
    }
    await useApi("/api/auth/logout-all", { method: "POST" })
    window.location.href = "/login"
  }

  device(s) {
    const ua = String(s.user_agent ?? s.userAgent ?? "")
    const browser = ua.includes("Edg") ? "Edge" : ua.includes("Chrome") ? "Chrome" : ua.includes("Firefox") ? "Firefox" : ua.includes("Safari") ? "Safari" : "Browser"
    const os = ua.includes("Android") ? "Android" : ua.includes("iPhone") ? "iPhone" : ua.includes("Windows") ? "Windows" : ua.includes("Mac") ? "macOS" : ua.includes("Linux") ? "Linux" : ""
    return os ? `${browser} on ${os}` : browser
  }

  mobile(s) {
    const ua = String(s.user_agent ?? s.userAgent ?? "")
    return ua.includes("Mobile") or ua.includes("Android") or ua.includes("iPhone")
  }

onMount
  async {
    const me = Auth.user ?? (await Auth.refresh())
    if me {
      this.profile = { name: me.name ?? "", phone: me.phone ?? "", job_title: me.job_title ?? "", avatar_url: me.avatar_url ?? null, notify_email: me.notify_email is not 0 and me.notify_email is not false, notify_sms: me.notify_sms is 1 or me.notify_sms is true }
    }
    await this.loadSessions()
  }

template
<div class="grid gap-6 lg:grid-cols-2">
  <form class="tx-panel p-5 sm:p-7 min-w-0" onsubmit.prevent="{{ save() }}">
    <h2 class="font-semibold mb-5">Profile</h2>
    <div class="flex items-center gap-4 mb-6">
      <Avatar name="{{ profile.name or 'You' }}" url="{{ profile.avatar_url }}" size="{{ 64 }}" staff="{{ Auth.isStaff() }}" />
      <div class="flex flex-wrap gap-2">
        <label class="tx-btn tx-btn-outline tx-btn-sm cursor-pointer">{{#if uploading}}<span class="tx-spinner"></span>{{#else}}<IconCamera />{{/if}} {{ profile.avatar_url ? "Change photo" : "Add a photo" }}<input type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" onchange="{{ pickAvatar($event) }}" /></label>
{{#if profile.avatar_url}}<button type="button" class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ removeAvatar() }}"><IconTrash /> Remove</button>{{/if}}
      </div>
    </div>
    <div class="tx-field"><label class="tx-label" for="pf-name">Full name</label><input id="pf-name" class="tx-input" autocomplete="name" bind:value="{{ profile.name }}" /></div>
    <div class="grid sm:grid-cols-2 gap-x-4">
      <div class="tx-field"><label class="tx-label" for="pf-phone">Phone</label><input id="pf-phone" type="tel" class="tx-input" autocomplete="tel" bind:value="{{ profile.phone }}" /></div>
      <div class="tx-field"><label class="tx-label" for="pf-title">Job title</label><input id="pf-title" class="tx-input" bind:value="{{ profile.job_title }}" /></div>
    </div>
    <div class="tx-field"><span class="tx-label">Email</span><p class="tx-input !bg-raised text-muted">{{ Auth.user?.email }}</p></div>
    <h3 class="font-semibold mt-6 mb-3 flex items-center gap-2"><IconBell class="w-4 h-4 text-brand" /> Notifications</h3>
    <label class="flex items-start gap-3 py-2"><input type="checkbox" class="tx-check mt-0.5" bind:checked="{{ profile.notify_email }}" /><span><span class="block text-sm font-medium">Email me about replies and updates</span><span class="block text-xs text-muted">Ticket replies, messages, invoices and project updates.</span></span></label>
    <label class="flex items-start gap-3 py-2"><input type="checkbox" class="tx-check mt-0.5" bind:checked="{{ profile.notify_sms }}" /><span><span class="block text-sm font-medium">Send me SMS updates</span><span class="block text-xs text-muted">{{ Auth.isStaff() ? "New tickets, replies and SLA breaches" : "Ticket updates, outages and billing reminders" }}, to the phone number above.</span></span></label>
    <button type="submit" class="tx-btn tx-btn-primary mt-5" disabled="{{ saving }}"><IconSave /> {{ saving ? "Saving…" : "Save profile" }}</button>
  </form>

  <div class="space-y-6 min-w-0">
    <section class="tx-panel p-5 sm:p-7">
      <h2 class="font-semibold mb-4 flex items-center gap-2"><IconPalette class="w-4 h-4 text-brand" /> Appearance</h2>
      <ThemeSwitch full="{{ true }}" />
    </section>

    <form class="tx-panel p-5 sm:p-7" onsubmit.prevent="{{ changePassword() }}">
      <h2 class="font-semibold mb-4 flex items-center gap-2"><IconKey class="w-4 h-4 text-brand" /> Password</h2>
{{#if pwError}}<div class="tx-alert tx-alert-error mb-4" role="alert"><p>{{ pwError }}</p></div>{{/if}}
      <div class="tx-field"><label class="tx-label" for="pw-cur">Current password</label><input id="pw-cur" type="password" autocomplete="current-password" class="tx-input" bind:value="{{ pw.currentPassword }}" /></div>
      <div class="grid sm:grid-cols-2 gap-x-4">
        <div class="tx-field"><label class="tx-label" for="pw-new">New password</label><input id="pw-new" type="password" autocomplete="new-password" class="tx-input" bind:value="{{ pw.password }}" /></div>
        <div class="tx-field"><label class="tx-label" for="pw-conf">Confirm</label><input id="pw-conf" type="password" autocomplete="new-password" class="tx-input" bind:value="{{ pw.confirm }}" /></div>
      </div>
      <button type="submit" class="tx-btn tx-btn-outline" disabled="{{ pwSaving }}">{{ pwSaving ? "Changing…" : "Change password" }}</button>
    </form>

    <section class="tx-panel p-5 sm:p-7">
      <div class="flex items-center justify-between mb-4"><h2 class="font-semibold">Signed-in devices</h2><button type="button" class="tx-btn tx-btn-danger tx-btn-sm" onclick="{{ signOutEverywhere() }}"><IconLogout /> Sign out everywhere</button></div>
      <ul class="space-y-2">
{{#each s in sessions}}
        <li class="tx-well px-4 py-3 flex items-center gap-3">
{{#if mobile(s)}}<IconDeviceMobile class="w-5 h-5 text-muted" />{{#else}}<IconDesktopComputer class="w-5 h-5 text-muted" />{{/if}}
          <span class="min-w-0 flex-1"><span class="block text-sm font-medium">{{ device(s) }}{{#if s.current}} <span class="tx-badge tone-brand ml-1">This device</span>{{/if}}</span><span class="block text-xs text-muted">{{ s.ip ?? "" }} · last used {{ Fmt.ago(s.last_used_at ?? s.lastUsedAt ?? s.created_at ?? s.createdAt) }}</span></span>
{{#if not s.current}}<button type="button" class="tx-btn tx-btn-ghost tx-btn-sm" onclick="{{ revoke(s) }}">Sign out</button>{{/if}}
        </li>
{{#else}}
        <li class="text-sm text-muted">Only this device.</li>
{{/each}}
      </ul>
    </section>
  </div>
</div>
