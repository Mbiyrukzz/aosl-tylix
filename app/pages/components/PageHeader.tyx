component PageHeader

// Title row for portal and console pages, with an optional back link,
// an eyebrow and actions on the right (slot="actions").

props
  title: String
  subtitle: String
  eyebrow: String
  back: String
  backLabel: String

template
  <div class="mb-6 sm:mb-8">
{{#if back}}
    <a href="{{ back }}" class="inline-flex items-center gap-1 text-sm text-muted hover:text-ink no-underline mb-3">← {{ backLabel or "Back" }}</a>
{{/if}}
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="min-w-0">
{{#if eyebrow}}<p class="tx-kicker mb-1.5">{{ eyebrow }}</p>{{/if}}
        <h1 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-balance">{{ title }}</h1>
{{#if subtitle}}<p class="mt-1 text-sm text-muted">{{ subtitle }}</p>{{/if}}
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0"><slot name="actions" /></div>
    </div>
  </div>
