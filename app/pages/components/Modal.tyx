component Modal

import { IconX } from "tylix-icons"

// A dialog. The parent shows it with {{#if}} and passes onClose.

props
  title: String
  subtitle: String
  wide: Boolean
  onClose: Function

action
  close() {
    this.onClose()
  }

onMount
  {
    const handler = (e) => {
      if e.key is "Escape" {
        document.removeEventListener("keydown", handler)
        this.onClose()
      }
    }
    document.addEventListener("keydown", handler)
  }

template
  <div class="tx-modal-scrim" onclick.self="{{ close() }}">
    <div class="tx-modal" class:tx-modal-lg="{{ wide }}" role="dialog" aria-modal="true" aria-label="{{ title }}">
      <div class="sticky top-0 z-10 bg-panel px-5 sm:px-6 py-4 border-b border-line flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold tracking-tight">{{ title }}</h2>
{{#if subtitle}}<p class="text-sm text-muted mt-0.5">{{ subtitle }}</p>{{/if}}
        </div>
        <button type="button" class="tx-icon-btn -mr-2" aria-label="Close" onclick="{{ close() }}"><IconX /></button>
      </div>
      <div class="p-5 sm:p-6"><slot /></div>
    </div>
  </div>
