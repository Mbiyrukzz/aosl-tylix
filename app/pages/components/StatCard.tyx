component StatCard

// A number on the dashboards. tone picks the icon colour; href makes it a link.

props
  label: String
  value: String
  hint: String
  tone: String
  href: String

computed
  toneClass() {
    const map = { brand: "bg-brand-soft/10 text-brand", sky: "bg-sky/10 text-sky", peach: "bg-peach/10 text-peach", coral: "bg-coral/10 text-coral", violet: "bg-violet/10 text-violet", gold: "bg-gold-soft/15 text-gold", mint: "bg-mint/10 text-mint" }
    return String(Reflect.get(map, this.tone or "brand") ?? map.brand)
  }

template
{{#if href}}
  <a href="{{ href }}" class="tx-panel tx-stat tx-hover block no-underline text-ink">
    <div class="tx-stat-label"><span class="{{ 'tx-stat-icon ' + toneClass }}"><slot /></span>{{ label }}</div>
    <p class="tx-stat-value">{{ value }}</p>
{{#if hint}}<p class="text-xs text-muted mt-1">{{ hint }}</p>{{/if}}
  </a>
{{#else}}
  <div class="tx-panel tx-stat">
    <div class="tx-stat-label"><span class="{{ 'tx-stat-icon ' + toneClass }}"><slot /></span>{{ label }}</div>
    <p class="tx-stat-value">{{ value }}</p>
{{#if hint}}<p class="text-xs text-muted mt-1">{{ hint }}</p>{{/if}}
  </div>
{{/if}}
