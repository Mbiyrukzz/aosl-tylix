component AshShell

// A small make-believe shell on the home page: visitors type (or tap)
// commands to explore products, services, business email and the live
// status. `status` reads the same /api/public/status as the status page.
// Up/Down walk the history, Tab completes a command.

uses
  Auth
  Catalog

state
  cmd: ""
  lines: [
    { k: "dim", t: "Ashmif shell 2026.11 · Mombasa, Kenya" },
    { k: "dim", t: "Type a command, or tap one below. Try `help`." }
  ]
  history: []
  hIndex: -1
  busy: false
  chips: ["help", "products", "email", "stack", "status", "contact"]
  commands: ["help", "products", "services", "email", "stack", "status", "contact", "open", "careers", "whoami", "date", "coffee", "clear"]

onMount
  {
    this.exec("help")
  }

action
  print(rows) {
    this.lines = [...this.lines, ...rows].slice(-80)
    setTimeout(() => {
      const box = document.getElementById("ash-out")
      if box {
        box.scrollTop = box.scrollHeight
      }
    }, 10)
  }

  focusInput(e) {
    if e.target.closest("button, a, input") or not window.matchMedia("(pointer: fine)").matches {
      return null
    }
    const el = document.getElementById("ash-in")
    if el {
      el.focus({ preventScroll: true })
    }
  }

  tap(c) {
    this.cmd = ""
    this.exec(c)
  }

  key(e) {
    if e.key is "Enter" {
      e.preventDefault()
      const value = String(e.target.value or "")
      this.cmd = ""
      e.target.value = ""
      this.exec(value)
    } else if e.key is "ArrowUp" {
      e.preventDefault()
      if this.history.length {
        this.hIndex = Math.min(this.history.length - 1, this.hIndex + 1)
        this.cmd = this.history[this.history.length - 1 - this.hIndex]
      }
    } else if e.key is "ArrowDown" {
      e.preventDefault()
      this.hIndex = Math.max(-1, this.hIndex - 1)
      this.cmd = this.hIndex < 0 ? "" : this.history[this.history.length - 1 - this.hIndex]
    } else if e.key is "Tab" {
      const typed = String(e.target.value or "").trim().toLowerCase()
      const hit = this.commands.find(c => typed and c.startsWith(typed))
      if hit {
        e.preventDefault()
        this.cmd = hit + (hit is "open" ? " " : "")
      }
    }
  }

  async exec(raw) {
    const input = String(raw).trim()
    this.hIndex = -1
    if not input {
      this.print([{ k: "in", t: "" }])
      return null
    }
    this.history = [...this.history, input].slice(-30)
    const parts = input.toLowerCase().split(/\s+/)
    const name = parts[0]
    const arg = parts.slice(1).join(" ")
    if name is "clear" {
      this.lines = []
      return null
    }
    this.print([{ k: "in", t: input }])
    if name is "help" {
      this.print([
        { k: "head", t: "Commands" },
        { k: "row", t: "products", d: "everything we sell" },
        { k: "row", t: "services", d: "what we build and run for you" },
        { k: "row", t: "email", d: "business email for your domain" },
        { k: "row", t: "stack", d: "languages and frameworks we ship in" },
        { k: "row", t: "status", d: "live health of every product" },
        { k: "row", t: "open <name>", d: "jump to a product, e.g. open medisynq" },
        { k: "row", t: "contact", d: "talk to a human" },
        { k: "row", t: "clear", d: "start over" }
      ])
    } else if name is "products" or name is "ls" {
      this.print([
        { k: "head", t: Catalog.products.length + " products" },
        ...Catalog.products.map(p => ({ k: "row", t: p.name, d: p.tagline })),
        { k: "dim", t: "→ open <name> to see one, e.g. open payroflix" }
      ])
    } else if name is "services" {
      this.print([
        { k: "head", t: "Services" },
        ...Catalog.services.map(s => ({ k: "row", t: s.title, d: s.body })),
        { k: "link", t: "/services", href: "/services" }
      ])
    } else if name is "email" or name is "mail" {
      this.print([
        { k: "head", t: "Business email" },
        { k: "out", t: "you@yourcompany.co.ke, on Private Email or Spacemail." },
        { k: "ok", t: "✔ we register or connect the domain" },
        { k: "ok", t: "✔ MX, SPF, DKIM and DMARC set for you" },
        { k: "ok", t: "✔ old mail moved over, phones and Outlook set up" },
        { k: "ok", t: "✔ support from the same portal as everything else" },
        { k: "link", t: "/contact?topic=email", href: "/contact?topic=email" }
      ])
    } else if name is "stack" {
      this.print([
        { k: "head", t: "We ship in" },
        { k: "row", t: "web", d: "Next.js, React, Vue, Nuxt, Angular, Tylix" },
        { k: "row", t: "backend", d: "Java & Spring, Node.js, PHP, Python, .NET, Go" },
        { k: "row", t: "mobile", d: "Flutter, React Native, native Android" },
        { k: "row", t: "data", d: "PostgreSQL, MySQL, MongoDB, Redis" },
        { k: "row", t: "cloud", d: "AWS, DigitalOcean, Hetzner, Cloudflare, Docker" },
        { k: "dim", t: "Already have a codebase? We'll work in it." }
      ])
    } else if name is "status" {
      this.busy = true
      this.print([{ k: "dim", t: "checking…" }])
      const r = await useApi("/api/public/status")
      this.busy = false
      if r.ok {
        const rows = r.data.products.map(p => ({ k: p.state is "operational" ? "okrow" : "warnrow", t: p.name, d: p.state }))
        const bad = r.data.products.filter(p => p.state is not "operational").length
        this.print([...rows, { k: bad ? "warn" : "ok", t: bad ? (bad is 1 ? "1 product needs attention" : `${bad} products need attention`) + " · details at /status" : "All systems operational" }])
      } else {
        this.print([{ k: "warn", t: "Couldn't reach the status service. Try /status." }])
      }
    } else if name is "open" or name is "cd" {
      const p = Catalog.products.find(x => x.slug is arg or x.name.toLowerCase() is arg or x.name.toLowerCase().replace(/\s+/g, "") is arg.replace(/\s+/g, ""))
      if p {
        this.print([{ k: "ok", t: `opening ${p.name}…` }])
        setTimeout(() => {
          window.location.href = "/products/" + p.slug
        }, 450)
      } else {
        this.print([{ k: "warn", t: arg ? `no product called "${arg}"` : "open what? e.g. open medisynq" }, { k: "dim", t: "names: " + Catalog.products.map(x => x.slug).join(", ") }])
      }
    } else if name is "contact" or name is "hire" {
      this.print([
        { k: "row", t: "email", d: "hello@ashmif.com" },
        { k: "row", t: "phone", d: "+254 758 839 829" },
        { k: "row", t: "hours", d: "Mon–Sat, 8am–6pm EAT" },
        { k: "link", t: "/contact", href: "/contact" }
      ])
    } else if name is "careers" or name is "jobs" {
      this.print([{ k: "out", t: "We hire engineers who like shipping real things." }, { k: "link", t: "/careers", href: "/careers" }])
    } else if name is "whoami" {
      this.print([{ k: "out", t: Auth.user ? `${Auth.user.name} · signed in` : "a curious visitor · welcome 👋" }])
    } else if name is "date" or name is "time" {
      const now = new Date().toLocaleString("en-GB", { timeZone: "Africa/Nairobi", weekday: "long", hour: "2-digit", minute: "2-digit" })
      this.print([{ k: "out", t: `${now} in Mombasa (EAT)` }])
    } else if name is "coffee" or name is "chai" {
      this.print([{ k: "out", t: "☕ Chai's on. The team's in, 8am–6pm EAT." }])
    } else if name is "sudo" {
      this.print([{ k: "warn", t: "Nice try. The only superpower here is our support team: type contact." }])
    } else {
      this.print([{ k: "warn", t: `command not found: ${name}` }, { k: "dim", t: "type help to see what's here" }])
    }
    return null
  }

template
  <div class="term" onclick="{{ focusInput($event) }}">
    <div class="term-bar">
      <i></i><i></i><i></i>
      <span class="term-title">guest@ashmif: ~</span>
      <span class="ml-auto hidden sm:inline-flex items-center gap-1.5 text-[11px] text-white/40"><span class="tx-live text-[#18c192]"></span> live</span>
    </div>
    <div id="ash-out" class="term-body" aria-live="polite">
{{#each l in lines}}
{{#if l.k is "in"}}
      <div><span class="t-p">❯</span> <span class="text-white">{{ l.t }}</span></div>
{{#else if l.k is "head"}}
      <div class="t-head">{{ l.t }}</div>
{{#else if l.k is "row"}}
      <div class="t-row"><span class="t-key">{{ l.t }}</span><span class="t-dim">{{ l.d }}</span></div>
{{#else if l.k is "okrow"}}
      <div class="t-row"><span class="t-key"><span class="t-ok">●</span> {{ l.t }}</span><span class="t-dim">{{ l.d }}</span></div>
{{#else if l.k is "warnrow"}}
      <div class="t-row"><span class="t-key"><span class="t-warn">●</span> {{ l.t }}</span><span class="t-warn">{{ l.d }}</span></div>
{{#else if l.k is "ok"}}
      <div class="t-ok">{{ l.t }}</div>
{{#else if l.k is "warn"}}
      <div class="t-warn">{{ l.t }}</div>
{{#else if l.k is "link"}}
      <div><a href="{{ l.href }}" class="t-link">→ {{ l.t }}</a></div>
{{#else if l.k is "dim"}}
      <div class="t-dim">{{ l.t }}</div>
{{#else}}
      <div>{{ l.t }}</div>
{{/if}}
{{/each}}
      <label class="flex items-center gap-2" for="ash-in">
        <span class="t-p">❯</span>
        <input id="ash-in" class="term-input" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Type a command" placeholder="{{ lines.length < 3 ? 'help' : '' }}" bind:value="{{ cmd }}" onkeydown="{{ key($event) }}" />
{{#if busy}}<span class="tx-spinner !w-3 !h-3 text-white/50"></span>{{/if}}
      </label>
    </div>
    <div class="term-chips">
{{#each c in chips}}
      <button type="button" class="term-chip" onclick="{{ tap(c) }}">{{ c }}</button>
{{/each}}
    </div>
  </div>
