page Services

import { IconMail, IconArrowRight, IconTarget, IconRefresh, IconCode, IconDeviceMobile, IconGlobe, IconPlug, IconServer, IconHeadphones, IconCheck, IconClock, IconUsers, IconShieldCheck } from "tylix-icons"

title "Services · Ashmif Office Solutions"

uses
  Catalog

state
  plans: [
    { tier: "silver", name: "Silver", hours: "24 hours", points: ["Portal tickets and quick messages", "Business-hours support", "Monthly updates"] },
    { tier: "gold", name: "Gold", hours: "8 hours", points: ["Everything in Silver", "Priority queue", "Account manager", "Quarterly review"] },
    { tier: "platinum", name: "Platinum", hours: "2 hours", points: ["Everything in Gold", "Urgent issues first", "Extended hours", "Change requests included"] }
  ]
  models: [
    { icon: "target", title: "Fixed-scope project", body: "A clear brief, a fixed price and a delivery date. Best for a new product, portal or integration.", points: ["Scope and screens signed off before code", "Weekly demos", "Handover and training"] },
    { icon: "team", title: "Dedicated team", body: "Engineers who work as part of your team, month to month, in Next.js, Java, Tylix or your stack.", points: ["Joins your standups and tools", "Scale up or down monthly", "Code stays in your repository"] },
    { icon: "rescue", title: "Takeover & rescue", body: "An app another team left behind? We audit it, stabilise it, then keep it running and improving.", points: ["Written code and security audit", "Upgrades to supported versions", "Moves onto a support plan"] }
  ]
  process: [
    { title: "Discovery", body: "We listen before we propose: goals, users, constraints and timeline, laid out clearly." },
    { title: "Design", body: "Wireframes, prototypes and a tight scope, so surprises are dealt with before code starts." },
    { title: "Build", body: "Weekly demos, fast iteration and real software in your hands early. No big-bang reveals." },
    { title: "Ship & support", body: "Deploy, monitor, iterate. Ongoing support so it keeps running long after launch." }
  ]

template
<div>
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute inset-0 bg-grid mask-fade-b"></div>
    <div class="relative tx-container py-16 sm:py-24 grid gap-10 lg:grid-cols-[1.3fr_1fr] items-end">
      <div>
        <p class="tx-eyebrow mb-5 fade-up">Services</p>
        <h1 class="fade-up fade-up-2 text-4xl sm:text-6xl font-bold tracking-tight text-balance">Custom software, hosting and support from one team</h1>
        <p class="fade-up fade-up-3 mt-5 text-lg text-soft max-w-2xl">When an off-the-shelf product doesn't fit, we design, build, host and support the system you actually need, in Next.js, Java, Tylix or the stack you already run.</p>
      </div>
      <div class="fade-up fade-up-4 flex flex-wrap gap-3 lg:justify-end">
        <a href="/contact?topic=project" class="tx-btn tx-btn-primary tx-btn-lg">Start a project <IconArrowRight /></a>
      </div>
    </div>
  </section>

  <section class="tx-container py-16 sm:py-20 scroll-mt-20" id="build">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
{{#each s in Catalog.services}}
      <div class="tx-panel p-7">
        <span class="tx-stat-icon bg-brand-soft/10 text-brand !w-11 !h-11 !rounded-xl">
{{#if s.slug is "web"}}<IconCode />{{#else if s.slug is "mobile"}}<IconDeviceMobile />{{#else if s.slug is "email"}}<IconMail />{{#else if s.slug is "sites"}}<IconGlobe />{{#else if s.slug is "api"}}<IconPlug />{{#else if s.slug is "hosting"}}<IconServer />{{#else}}<IconHeadphones />{{/if}}
        </span>
        <h2 class="mt-5 text-xl font-bold tracking-tight">{{ s.title }}</h2>
        <p class="mt-2 text-soft leading-relaxed">{{ s.body }}</p>
      </div>
{{/each}}
    </div>
  </section>

  <section class="tx-container pb-16 sm:pb-20 scroll-mt-20" id="stack">
    <p class="tx-eyebrow mb-4">Technologies</p>
    <h2 class="section-title mb-4">Your stack or ours</h2>
    <p class="text-soft text-lg max-w-3xl mb-8">We ship production systems in Next.js, Java, PHP, Python and Tylix, our own open-source framework, and we're just as fluent in the frameworks your team already uses. Taking over an app another team left behind, or adding a mobile app to an existing backend, is everyday work for us.</p>
    <StackGrid />
  </section>

  <section class="tx-container pb-16 sm:pb-20 scroll-mt-20" id="models">
    <p class="tx-eyebrow mb-4">Ways to work with us</p>
    <h2 class="section-title mb-10">Pick the engagement that fits</h2>
    <div class="grid gap-4 lg:grid-cols-3">
{{#each m in models}}
      <div class="tx-panel p-7 flex flex-col">
        <span class="tx-stat-icon bg-brand-soft/10 text-brand !w-11 !h-11 !rounded-xl">
{{#if m.icon is "target"}}<IconTarget />{{#else if m.icon is "team"}}<IconUsers />{{#else}}<IconRefresh />{{/if}}
        </span>
        <h3 class="mt-5 text-xl font-bold tracking-tight">{{ m.title }}</h3>
        <p class="mt-2 text-soft leading-relaxed">{{ m.body }}</p>
        <ul class="mt-5 pt-5 border-t border-line space-y-2.5 list-none p-0 m-0">
{{#each pt in m.points}}
          <li class="flex gap-2.5 text-sm text-soft"><IconCheck class="w-4 h-4 mt-0.5 text-brand shrink-0" /> {{ pt }}</li>
{{/each}}
        </ul>
      </div>
{{/each}}
    </div>
  </section>

  <section class="border-y border-line bg-panel/50">
    <div class="tx-container py-16 sm:py-20">
      <p class="tx-eyebrow mb-4">Process</p>
      <h2 class="section-title mb-10">From first call to years in production</h2>
      <ol class="grid gap-4 md:grid-cols-4">
{{#each step, i in process}}
        <li class="relative tx-panel p-6">
          <span class="font-mono text-xs text-brand">0{{ i + 1 }}</span>
          <h3 class="mt-3 text-lg font-bold">{{ step.title }}</h3>
          <p class="mt-2 text-sm text-soft leading-relaxed">{{ step.body }}</p>
        </li>
{{/each}}
      </ol>
    </div>
  </section>

  <section class="tx-container py-16 sm:py-20 scroll-mt-20" id="plans">
    <div class="max-w-2xl">
      <p class="tx-eyebrow mb-4">Support plans</p>
      <h2 class="section-title">Response times you can see in your portal</h2>
      <p class="mt-4 text-soft">Every ticket shows its first-response target based on your plan and the priority you pick. Urgent issues get half the time.</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
{{#each plan in plans}}
      <div class="tx-panel p-7" class:ring-1="{{ plan.tier is 'gold' }}" class:ring-gold-soft="{{ plan.tier is 'gold' }}">
        <div class="flex items-center justify-between">
          <StatusBadge value="{{ plan.tier }}" />
          <IconClock class="w-5 h-5 text-muted" />
        </div>
        <p class="mt-5 text-sm text-muted">First response within</p>
        <p class="text-3xl font-bold tracking-tight">{{ plan.hours }}</p>
        <ul class="mt-6 space-y-2.5">
{{#each pt in plan.points}}
          <li class="flex gap-2.5 text-sm text-soft"><IconCheck class="w-4 h-4 mt-0.5 text-brand shrink-0" /> {{ pt }}</li>
{{/each}}
        </ul>
      </div>
{{/each}}
    </div>
  </section>
</div>
