page AdminProjects

import { IconPlus, IconKanban, IconCalendar } from "tylix-icons"

title "Projects · Ashmif console"

uses
  Fmt

state
  projects: []
  companies: []
  staff: []
  loading: true
  view: "active"
  open: false

computed
  visible() {
    return this.projects.filter(p => this.view is "all" or (this.view is "active" ? p.status is not "completed" and p.status is not "cancelled" : p.status is "completed"))
  }

action
  created(p) {
    window.location.href = `/admin/projects/${p.id}`
  }

  late(p) {
    return p.due_on and p.status is not "completed" and new Date(p.due_on).getTime() < Date.now()
  }

onMount
  async {
    const [r, c, s] = await Promise.all([useApi("/api/admin/projects"), useApi("/api/admin/companies"), useApi("/api/admin/staff")])
    if r.ok {
      this.projects = r.data
    }
    if c.ok {
      this.companies = c.data
    }
    if s.ok {
      this.staff = s.data
    }
    this.loading = false
  }

template
<div>
  <PageHeader title="Projects" subtitle="Client builds, with progress and updates clients can follow.">
    <button slot="actions" type="button" class="tx-btn tx-btn-primary" onclick="{{ open = true }}"><IconPlus /> New project</button>
  </PageHeader>
  <div class="tx-tabs w-fit mb-4">
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'active' }}" onclick="{{ view = 'active' }}">Active</button>
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'done' }}" onclick="{{ view = 'done' }}">Completed</button>
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'all' }}" onclick="{{ view = 'all' }}">All</button>
  </div>
{{#if loading}}
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><div class="tx-skeleton h-44"></div><div class="tx-skeleton h-44"></div></div>
{{#else}}
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
{{#each p in visible}}
    <a href="{{ `/admin/projects/${p.id}` }}" class="tx-panel tx-hover p-5 no-underline text-ink flex flex-col">
      <div class="flex items-start justify-between gap-2"><div class="min-w-0"><p class="font-semibold leading-snug">{{ p.title }}</p><p class="text-xs text-muted mt-0.5">{{ p.company_name }}</p></div><StatusBadge value="{{ p.status }}" /></div>
      <div class="mt-5 flex items-center gap-3"><div class="tx-progress flex-1"><span style:width="{{ p.progress + '%' }}"></span></div><span class="text-sm font-semibold tabular">{{ p.progress }}%</span></div>
      <div class="mt-4 flex items-center justify-between text-xs text-muted">
        <span class="{{ 'flex items-center gap-1.5 ' + (late(p) ? 'text-coral font-semibold' : '') }}"><IconCalendar class="w-3.5 h-3.5" /> {{ p.due_on ? Fmt.date(p.due_on) : "No target" }}</span>
{{#if p.lead}}<span class="flex items-center gap-1.5"><Avatar name="{{ p.lead.name }}" url="{{ p.lead.avatar_url }}" size="{{ 20 }}" staff="{{ true }}" /> {{ p.lead.name.split(" ")[0] }}</span>{{/if}}
      </div>
    </a>
{{#else}}
    <div class="md:col-span-2 xl:col-span-3 tx-empty"><IconKanban /><p class="font-semibold">No projects here</p></div>
{{/each}}
  </div>
{{/if}}
{{#if open}}
  <Modal title="New project" subtitle="The client's team is notified and can follow it in their portal." wide="{{ true }}" onClose="{{ () => open = false }}">
    <ProjectForm project="{{ null }}" companyId="{{ 0 }}" companies="{{ companies }}" staff="{{ staff }}" onSaved="{{ (p) => created(p) }}" onCancel="{{ () => open = false }}" />
  </Modal>
{{/if}}
</div>
