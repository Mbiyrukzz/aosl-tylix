page AdminLeads

import { IconTarget, IconMail, IconPhone, IconBuildingOffice, IconUserAdd, IconWhatsapp } from "tylix-icons"

title "Leads · Ashmif console"

uses
  Fmt
  Live

state
  leads: []
  loading: true
  view: "new"
  selected: null

computed
  visible() {
    return this.leads.filter(l => this.view is "all" or (this.view is "new" ? l.status is "new" : this.view is "active" ? l.status is "contacted" or l.status is "qualified" : l.status is "won" or l.status is "lost"))
  }

action
  async load() {
    const r = await useApi("/api/admin/leads")
    if r.ok {
      this.leads = r.data
      if this.selected {
        this.selected = r.data.find(l => l.id is this.selected.id) ?? null
      }
    }
    this.loading = false
  }

  async setStatus(l, status) {
    await useApi(`/api/admin/leads/${l.id}`, { method: "PUT", body: { status } })
    Live.say(`Marked ${Fmt.label(status).toLowerCase()}`)
    await this.load()
    Live.tick()
  }

  async convert(l) {
    if not confirm(`Create a client company for ${l.company or l.name} and invite ${l.email} to the portal?`) {
      return null
    }
    const r = await useApi(`/api/admin/leads/${l.id}/convert`, { method: "POST" })
    if r.ok {
      window.location.href = `/admin/clients/${r.data.company_id}`
    } else {
      Live.say(Live.errorOf(r, "Couldn't convert."))
    }
  }

  wa(phone) {
    return "https://wa.me/" + String(phone ?? "").replace(/[^0-9]/g, "")
  }

onMount
  async {
    await this.load()
    const id = Number(new URLSearchParams(window.location.search).get("id"))
    if id {
      this.selected = this.leads.find(l => l.id is id) ?? null
    }
  }

template
<div>
  <PageHeader title="Leads" subtitle="Enquiries from the website contact form and the guest support widget." />
  <div class="tx-tabs w-fit mb-4">
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'new' }}" onclick="{{ view = 'new' }}">New <span class="count">{{ leads.filter(l => l.status is 'new').length }}</span></button>
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'active' }}" onclick="{{ view = 'active' }}">In progress</button>
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'closed' }}" onclick="{{ view = 'closed' }}">Closed</button>
    <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'all' }}" onclick="{{ view = 'all' }}">All</button>
  </div>
{{#if loading}}
  <PageLoader label="Loading leads" />
{{#else}}
  <div class="grid gap-6 lg:grid-cols-[1fr_24rem]">
    <div class="tx-panel overflow-hidden min-w-0"><ul class="tx-list">
{{#each l in visible}}
      <li>
        <button type="button" class="{{ 'w-full text-left px-5 py-4 flex gap-4 border-0 cursor-pointer ' + (selected?.id is l.id ? 'bg-brand-soft/10' : 'bg-transparent hover:bg-raised/60') }}" onclick="{{ selected = l }}">
          <Avatar name="{{ l.name }}" size="{{ 36 }}" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2"><span class="text-sm font-semibold truncate">{{ l.name }}{{ l.company ? " · " + l.company : "" }}</span><span class="text-[11px] text-muted shrink-0">{{ Fmt.ago(l.created_at) }}</span></span>
            <span class="block text-xs text-muted mt-0.5">{{ Fmt.label(l.topic) }}{{ l.product_name ? " · " + l.product_name : "" }}</span>
            <span class="block text-sm text-soft mt-1 line-clamp-2">{{ l.message }}</span>
          </span>
          <StatusBadge value="{{ l.status }}" />
        </button>
      </li>
{{#else}}
      <li class="px-5 py-10 text-center text-sm text-muted"><IconTarget class="w-6 h-6 mx-auto mb-2 text-brand" />No leads here.</li>
{{/each}}
    </ul></div>
    <aside class="min-w-0">
{{#if selected}}
      <div class="tx-panel p-5 lg:sticky lg:top-24 space-y-4">
        <div class="flex items-center gap-3"><Avatar name="{{ selected.name }}" size="{{ 44 }}" /><div class="min-w-0"><p class="font-semibold">{{ selected.name }}</p><p class="text-xs text-muted">{{ Fmt.dateTime(selected.created_at) }}</p></div></div>
        <div class="space-y-2 text-sm">
          <a href="{{ 'mailto:' + selected.email }}" class="flex items-center gap-2 tx-link"><IconMail class="w-4 h-4" /> {{ selected.email }}</a>
{{#if selected.phone}}<a href="{{ 'tel:' + selected.phone }}" class="flex items-center gap-2 text-soft no-underline"><IconPhone class="w-4 h-4 text-muted" /> {{ selected.phone }}</a><a href="{{ wa(selected.phone) }}" target="_blank" rel="noopener" class="flex items-center gap-2 text-soft no-underline"><IconWhatsapp class="w-4 h-4 text-muted" /> WhatsApp</a>{{/if}}
{{#if selected.company}}<p class="flex items-center gap-2"><IconBuildingOffice class="w-4 h-4 text-muted" /> {{ selected.company }}</p>{{/if}}
        </div>
        <div class="tx-well p-4 tx-prose text-sm">{{ selected.message }}</div>
        <div><label class="tx-kicker block mb-1.5" for="ld-status">Status</label><select id="ld-status" class="tx-input text-sm" onchange="{{ setStatus(selected, $event.target.value) }}"><option value="new" selected="{{ selected.status is 'new' }}">New</option><option value="contacted" selected="{{ selected.status is 'contacted' }}">Contacted</option><option value="qualified" selected="{{ selected.status is 'qualified' }}">Qualified</option><option value="won" selected="{{ selected.status is 'won' }}">Won</option><option value="lost" selected="{{ selected.status is 'lost' }}">Lost</option></select></div>
{{#if selected.status is not "won"}}<button type="button" class="tx-btn tx-btn-primary tx-btn-block" onclick="{{ convert(selected) }}"><IconUserAdd /> Make them a client</button>{{/if}}
      </div>
{{#else}}
      <div class="tx-empty"><p class="text-sm text-muted">Pick a lead to see details.</p></div>
{{/if}}
    </aside>
  </div>
{{/if}}
</div>
