page AdminServices

import { IconPlus, IconSearch, IconCalendarClock, IconPackage, IconCoins, IconAlertOctagon } from "tylix-icons"

title "Services & renewals · Ashmif console"

uses
  Fmt
  Live

state
  subs: []
  companies: []
  loading: true
  view: "soon"
  query: ""
  open: false
  editing: null

computed
  visible() {
    const q = this.query.trim().toLowerCase()
    return this.subs.filter(s => {
      if this.view is "soon" and not (s.status is "active" and s.days_left !== null and s.days_left <= 30) {
        return false
      }
      if this.view is "active" and s.status is not "active" {
        return false
      }
      return not q or s.name.toLowerCase().includes(q) or s.company_name.toLowerCase().includes(q) or (s.reference ?? "").toLowerCase().includes(q)
    })
  }

  recurring() {
    let total = 0
    for const s of this.subs.filter(x => x.status is "active") {
      const mult = { monthly: 12, quarterly: 4, yearly: 1, one_time: 0 }
      total += Number(s.amount) * Number(Reflect.get(mult, s.cycle) ?? 1)
    }
    return total
  }

action
  async load() {
    const r = await useApi("/api/admin/subscriptions")
    if r.ok {
      this.subs = r.data
    }
    this.loading = false
  }

  edit(s) {
    this.editing = s
    this.open = true
  }

  async saved() {
    this.open = false
    Live.say("Saved")
    await this.load()
  }

onMount
  async {
    const c = await useApi("/api/admin/companies")
    if c.ok {
      this.companies = c.data
    }
    await this.load()
  }

template
<div>
  <PageHeader title="Services & renewals" subtitle="Subscriptions, domains, hosting and Sender IDs across all clients.">
    <button slot="actions" type="button" class="tx-btn tx-btn-primary" onclick="{{ edit(null) }}"><IconPlus /> Add service</button>
  </PageHeader>
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 mb-6">
    <StatCard label="Active services" value="{{ String(subs.filter(s => s.status is 'active').length) }}" tone="brand"><IconPackage /></StatCard>
    <StatCard label="Renew in 30 days" value="{{ String(subs.filter(s => s.status is 'active' and s.days_left !== null and s.days_left <= 30).length) }}" tone="peach"><IconCalendarClock /></StatCard>
    <div class="col-span-2 lg:col-span-1"><StatCard label="Annual recurring revenue" value="{{ Fmt.money(recurring) }}" tone="mint"><IconCoins /></StatCard></div>
  </div>
  <div class="flex flex-col sm:flex-row gap-2 mb-4">
    <div class="tx-tabs w-fit">
      <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'soon' }}" onclick="{{ view = 'soon' }}">Renewing soon</button>
      <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'active' }}" onclick="{{ view = 'active' }}">Active</button>
      <button type="button" class="tx-tab" class:tx-tab-active="{{ view is 'all' }}" onclick="{{ view = 'all' }}">All</button>
    </div>
    <div class="relative sm:ml-auto sm:w-72"><IconSearch class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted" /><input class="tx-input !pl-10 !rounded-full !py-2 text-sm" placeholder="Search services or clients" aria-label="Search" bind:value="{{ query }}" /></div>
  </div>
{{#if loading}}
  <PageLoader label="Loading services" />
{{#else}}
  <div class="tx-panel overflow-hidden"><div class="tx-table-wrap"><table class="tx-table">
    <thead><tr><th>Service</th><th>Client</th><th class="hidden md:table-cell text-right">Price</th><th>Renews</th><th>Status</th></tr></thead>
    <tbody>
{{#each s in visible}}
      <tr data-href="1" onclick="{{ edit(s) }}">
        <td class="min-w-[12rem]"><p class="text-sm font-semibold">{{ s.name }}</p><p class="text-xs text-muted">{{ s.product_name ?? Fmt.label(s.kind) }}{{ s.reference ? " · " + s.reference : "" }}</p></td>
        <td class="text-sm"><a href="{{ `/admin/clients/${s.company_id}` }}" class="tx-link" onclick.stop="{{ null }}">{{ s.company_name }}</a></td>
        <td class="hidden md:table-cell text-right text-sm tabular">{{ s.amount ? Fmt.money(s.amount, s.currency) : "—" }}<span class="text-xs text-muted">{{ s.amount ? " /" + (s.cycle is "monthly" ? "mo" : s.cycle is "quarterly" ? "qtr" : s.cycle is "yearly" ? "yr" : "once") : "" }}</span></td>
        <td class="text-sm whitespace-nowrap">{{ Fmt.date(s.renews_on) }}{{#if s.days_left !== null and s.days_left <= 30}}<span class="{{ 'ml-2 tx-badge ' + (s.days_left < 0 ? 'tone-coral' : s.days_left <= 7 ? 'tone-peach' : 'tone-sky') }}">{{ s.days_left < 0 ? "expired" : s.days_left + "d" }}</span>{{/if}}</td>
        <td>{{#if s.auto_renew}}<span class="tx-badge tone-mint">Auto</span>{{#else}}<StatusBadge value="{{ s.status }}" />{{/if}}</td>
      </tr>
{{#else}}
      <tr><td colspan="5" class="text-center text-sm text-muted py-10">{{ view is "soon" ? "Nothing renews in the next 30 days." : "No services found." }}</td></tr>
{{/each}}
    </tbody>
  </table></div></div>
{{/if}}
{{#if open}}
  <Modal title="{{ editing ? 'Edit service' : 'Add a service' }}" subtitle="{{ editing ? editing.company_name : '' }}" wide="{{ true }}" onClose="{{ () => open = false }}">
    <SubscriptionForm subscription="{{ editing }}" companyId="{{ 0 }}" companies="{{ companies }}" onSaved="{{ () => saved() }}" onCancel="{{ () => open = false }}" />
  </Modal>
{{/if}}
</div>
